# Runs a command with a deadline (whole seconds). Exit 143 = it was stopped. A Ctrl-C meant for "stop after this
# step" never cuts a TV command short: background commands ignore SIGINT, and wait is resumed after the trap.
with_timeout() {
	local t=$1 pid w rc
	shift
	"$@" &
	pid=$!
	(
		i=0
		while [ "$i" -lt "$t" ]; do
			sleep 1
			kill -0 "$pid" 2>/dev/null || exit 0
			i=$((i + 1))
		done
		kill "$pid" 2>/dev/null
		sleep 2
		kill -9 "$pid" 2>/dev/null
	) >/dev/null 2>&1 &
	w=$!
	wait "$pid" 2>/dev/null # no "Terminated" notice for a command that ran out of time
	rc=$?
	while [ "$rc" -gt 128 ] && kill -0 "$pid" 2>/dev/null; do
		wait "$pid" 2>/dev/null
		rc=$?
	done
	kill "$w" 2>/dev/null
	wait "$w" 2>/dev/null
	return "$rc"
}

sha256_of() {
	if command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | awk '{print $1}'
	elif command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | awk '{print $1}'
	else
		openssl dgst -sha256 "$1" | awk '{print $NF}'
	fi
}

# JSON string literal for text we write (names are validated elsewhere; this only has to escape safely).
json_str() {
	local s=$1
	s=${s//\\/\\\\}
	s=${s//\"/\\\"}
	s=$(printf '%s' "$s" | tr '\t\n\r' '   ')
	printf '"%s"' "$s"
}

