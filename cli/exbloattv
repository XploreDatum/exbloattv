# Prompt and read one line into REPLY. End of input (a pipe that ran out) counts as the default answer.
ask() {
	printf '%s' "$1"
	if ! IFS= read -r REPLY; then
		REPLY=$2
		printf '\n'
	fi
	[ -t 0 ] || printf '%s\n' "$REPLY" # piped answers: keep the transcript readable
	[ -n "$REPLY" ] || REPLY=$2
}

