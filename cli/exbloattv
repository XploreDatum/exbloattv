	mkdir -p "$CONF_DIR" 2>/dev/null || return 0
	printf '%s\n' "$@" >"$CONF_DIR/$f.tmp.$$" && mv "$CONF_DIR/$f.tmp.$$" "$CONF_DIR/$f"
}

# How this computer signs the lock and its changes on the TV, like the app's "<model> · <4 chars of an install id>".
me_name() {
	local id host
	id=$(conf_get install-id id)
	if [ -z "$id" ]; then
		id=$(rand_hex)
		conf_put install-id "id=$id"
	fi
	host=$(hostname 2>/dev/null | cut -d. -f1 | tr -cd 'A-Za-z0-9 _-')
	ME="${host:-computer} (exbloattv CLI) · ${id:0:4}"
}

# --- adb -------------------------------------------------------------------------------------------------------------

find_adb() {
	local c
	for c in "$(command -v adb 2>/dev/null)" "${ANDROID_HOME:-/nonexistent}/platform-tools/adb" \
		"${ANDROID_SDK_ROOT:-/nonexistent}/platform-tools/adb" "$HOME/Library/Android/sdk/platform-tools/adb" \
		"$HOME/Android/Sdk/platform-tools/adb"; do
		if [ -n "$c" ] && [ -x "$c" ]; then
			ADB=$c
			return 0
		fi
	done
	bad "adb isn't installed (it comes with Android's platform tools)."
	say "Install it, then run exbloattv again:"
	say "  macOS          brew install --cask android-platform-tools"
	say "  Debian/Ubuntu  sudo apt install adb"
	say "  Fedora         sudo dnf install android-tools"
	say "  Arch           sudo pacman -S android-tools"
	exit 127
}

# Runs one shell command on the TV. Sets TV_OUT (\r removed) and TV_RC (the command's own exit code, read from a
# marker so it works on old TVs without adb's shell protocol v2). TV_RC=255: no answer (connection lost, timed out).
tv_sh() {
	local f=$TMPD/out
	with_timeout "${2:-60}" "$ADB" -s "$SERIAL" shell "$1; r=\$?; echo; echo @@rc=\$r" </dev/null >"$f.raw" 2>&1
	tr -d '\r' <"$f.raw" >"$f"
	TV_OUT=''
	IFS= read -r -d '' TV_OUT <"$f"
	case $TV_OUT in
	*@@rc=*)
		TV_RC=${TV_OUT##*@@rc=}
		TV_RC=${TV_RC%%[!0-9]*}
		TV_OUT=${TV_OUT%@@rc=*}
		TV_OUT=${TV_OUT%$'\n'}
		[ -n "$TV_RC" ] || TV_RC=255
		;;
	*) TV_RC=255 ;;
	esac
}

# A command that changes the TV: printed instead of run under --dry-run.
tv_do() {
	if [ "$DRY" = 1 ]; then
		printf '  %sadb -s %s shell %s%s\n' "$C_DIM" "$SERIAL" "$1" "$C_OFF"
		TV_OUT='' TV_RC=0
		return 0
	fi
	tv_sh "$@"
}

pm_error() { case $1 in *"Exception occurred"* | *"Error:"* | *Failure*) return 0 ;; esac; return 1; }

# A read that must succeed. Returns 0 ok, 1 failed read (READ_FAILED names it), 2 no answer from the TV.
tv_read() { # tv_read "what" "cmd" [pm]
	tv_sh "$2"
	if [ "$TV_RC" = 255 ]; then
		READ_FAILED=$1
		return 2
	fi
	if [ "$TV_RC" != 0 ] || { [ "${3:-}" = pm ] && pm_error "$TV_OUT"; }; then
		READ_FAILED=$1
		return 1
	fi
	return 0
}

# listed FLAG PKG: 0 = listed by `pm list packages FLAG PKG` ("" installed, -e on, -d off, -3 user app), 1 = not, 2+ = read failed.
listed() {
	local cmd="pm list packages${1:+ $1} $2"
	tv_read "app list" "$cmd" pm || return $(($? + 1))
	printf '%s\n' "$TV_OUT" | grep -qxF "package:$2"
}

# PRESENCE = ENABLED / DISABLED / ABSENT. Returns non-zero if the TV couldn't be read.
presence() {
	listed -d "$1"
	case $? in
	0) PRESENCE=DISABLED && return 0 ;;
	1) ;;
	*) return 1 ;;
	esac
	listed "" "$1"
	case $? in
	0) PRESENCE=ENABLED ;;
	1) PRESENCE=ABSENT ;;
	*) return 1 ;;
	esac
}

home_pkgs_from() { printf '%s\n' "$1" | awk '/^[ \t]*ActivityInfo:/ {w=1; next} w && /^[ \t]*packageName=/ {sub(/^[ \t]*packageName=/, ""); if (!s[$0]++) print; w=0}'; }
resolved_from() { printf '%s\n' "$1" | grep -E '^[[:space:]]*[A-Za-z0-9_.]+/[A-Za-z0-9_.$]+[[:space:]]*$' | tail -n 1 | tr -d ' \t'; }

# HOME_PKG = the package HOME resolves to ("" if none). Fails on an unreadable answer.
resolved_home() {
	tv_read "current home screen" "$RESOLVE_HOME" || return 1
	HOME_PKG=$(resolved_from "$TV_OUT")
	HOME_PKG=${HOME_PKG%%/*}
}

# HOMES = the packages that can be the home screen (space separated).
home_packages() {
	tv_read "home screen apps" "${QUERY}HOME" || return 1
	HOMES=$(home_pkgs_from "$TV_OUT" | tr '\n' ' ')
}

# FG = the package in front (Parsers.foregroundPackage): topResumedActivity, else the focused ResumedActivity, else
# the first mResumedActivity of Display #0.
foreground() {
	FG=''
	tv_sh "dumpsys activity activities" 20
	[ "$TV_RC" = 0 ] || return 1
	FG=$(printf '%s\n' "$TV_OUT" | awk '
		function pkg(line) { if (match(line, "ActivityRecord[{][^}]* u[0-9]+ [^/ ]+/")) { line = substr(line, RSTART, RLENGTH - 1); sub(/.* /, "", line); return line } return "" }
		/^[ \t]*topResumedActivity=/ && top == "" { top = pkg($0) }
		/^[ \t]*ResumedActivity:/ && foc == "" { foc = pkg($0) }
		/^[ \t]*Display #/ { sections = 1; d0 = ($0 ~ /Display #0/) }
		/^[ \t]*mResumedActivity:/ { if (any == "") any = pkg($0); if (d0 && in0 == "") in0 = pkg($0) }
		END { print (top != "" ? top : foc != "" ? foc : sections ? in0 : any) }')
}

poll() { # poll SECONDS command...: true once the command succeeds (every half second)
	local end=$(($(date +%s) + $1))
	shift
	while :; do
		sleep 0.5
		"$@" && return 0
		[ "$(date +%s)" -lt "$end" ] || return 1
	done
}
fg_in() { foreground && [ -n "$FG" ] && in_list "$FG" "$1"; }
home_is_flauncher() { resolved_home && [ "$HOME_PKG" = "$FLAUNCHER_PKG" ] && foreground && [ "$FG" = "$FLAUNCHER_PKG" ]; }

# --- SafetyGuard: packages that are never switched off or removed (generated from SafetyGuard.kt) -------------------

load_safety() {
	SAFE_NEVER=$(never_disable | tr '\n' ' ')
	SAFE_REMOTE=$(remote_input | tr '\n' ' ')
}

glob_any() { # glob_any PKG "glob glob…": globs use only `*` (any run of characters), like SafetyGuard
	local g
	set -f
	for g in $2; do
		# shellcheck disable=SC2254 # the glob is the pattern on purpose
		case $1 in $g)
			set +f
			return 0
			;;
		esac
	done
	set +f
	return 1
}
safety_protected() { glob_any "$1" "$SAFE_NEVER" || glob_any "$1" "$SAFE_REMOTE"; }

# The runner's check right before switching something off: SafetyGuard plus the home screen in use. Fails closed:
# if HOME doesn't resolve to one real app, every app that can be the home screen is protected.
# Returns 0 protected, 1 not protected, 2 the TV couldn't be read.
protected_now() {
	safety_protected "$1" && return 0
	resolved_home || return 2
	if [ -n "$HOME_PKG" ] && ! in_list "$HOME_PKG" "$NOT_A_REAL_HOME"; then
		[ "$1" = "$HOME_PKG" ] && return 0
		return 1
	fi
	home_packages || return 2
	[ -n "$HOMES" ] || {
		READ_FAILED="home screen apps"
		return 2
	}
	in_list "$1" "$HOMES" && return 0
	return 1
}

# --- JSON: one small parser for the TV's state file (and the catalog, for the generator) ----------------------------
#
# EXB_MODE=flat  prints every leaf as "path<TAB>value" (entries.0.pattern  com.netflix.ninja).
# EXB_MODE=info  prints the state file's serial, version, lock and change log as \037-separated rows.
# EXB_MODE=edit  re-emits the object with EXB_LOCK / EXB_ORIGINAL / EXB_LATEST / EXB_DROP (ids) / EXB_UPSERT (change
#                objects, one per line) applied. Everything else is copied byte for byte, so restore points and
#                fields this version doesn't know survive a rewrite.
# Parse errors print "ERR" and exit 3. Always run with LC_ALL=C (byte-wise substr keeps it fast).

# shellcheck disable=SC2016 # awk program, not shell
JSON_AWK='
function fail(m) { print "ERR" US m; exit 3 }
function ws(  c) { while (pos <= n) { c = substr(s, pos, 1); if (c == " " || c == "\t" || c == "\n" || c == "\r") pos++; else break } }
function hexval(h,  v, i, d) { v = 0; h = tolower(h); for (i = 1; i <= 4; i++) { d = index("0123456789abcdef", substr(h, i, 1)); if (!d) return -1; v = v * 16 + d - 1 } return v }
function pstr(   c, out, v) {
	pos++; out = ""
	while (pos <= n) {
		c = substr(s, pos, 1)
		if (c == "\"") { pos++; return out }
		if (c == "\\") {
			pos++; c = substr(s, pos, 1)
			if (c == "u") { v = hexval(substr(s, pos + 1, 4)); pos += 4; out = out ((v >= 32 && v < 127) ? sprintf("%c", v) : "?") }
			else if (c == "\"" || c == "\\" || c == "/") out = out c
			else out = out " "
			pos++; continue
		}
		out = out c; pos++
	}
	fail("unterminated string")
}
function leaf(p, t, v) { typ[p] = t; val[p] = v; if (mode == "flat") { gsub(/[\t\n\r]/, " ", v); print p "\t" v } }
function pval(path, d,    c, k, st, kst, i, kp) {
	ws(); c = substr(s, pos, 1)
	if (c == "{") {
		typ[path] = "o"; pos++; ws()
		if (substr(s, pos, 1) == "}") { pos++; return }
		while (1) {
			ws(); if (substr(s, pos, 1) != "\"") fail("expected a key")
			kst = pos; k = pstr(); ws()
			if (substr(s, pos, 1) != ":") fail("expected :")
			if (d == 0) rawkey[k] = substr(s, kst, pos - kst)
			pos++; ws(); st = pos
			kp = (path == "" ? k : path "." k)
			pval(kp, d + 1)
			if (d == 0) { if (!(k in raw)) keys[++nk] = k; raw[k] = substr(s, st, pos - st) }
			ws(); c = substr(s, pos, 1); pos++
			if (c == "}") return
			if (c != ",") fail("expected , or }")
		}
	}
	if (c == "[") {
		typ[path] = "a"; pos++; ws()
		if (substr(s, pos, 1) == "]") { pos++; return }
		i = 0
		while (1) {
			ws(); st = pos
			pval(path "." i, d + 1)
			if (d == 1 && path == "changes") { craw[++nc] = substr(s, st, pos - st); cpath[nc] = path "." i }
			i++
			ws(); c = substr(s, pos, 1); pos++
			if (c == "]") return
			if (c != ",") fail("expected , or ]")
		}
	}
	if (c == "\"") { leaf(path, "s", pstr()); return }
	st = pos
	while (pos <= n && index(",}] \t\r\n", substr(s, pos, 1)) == 0) pos++
	c = substr(s, st, pos - st)
	if (c == "null") leaf(path, "n", c)
	else if (c == "true" || c == "false") leaf(path, "b", c)
	else if (c ~ /^-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?$/) leaf(path, "d", c)
	else fail("bad value at " pos)
}
function clean(v) { gsub(/[\t\n\r\037]/, " ", v); return v }
function info(  i, p) {
	print "serial" US typ["serial"] US clean(val["serial"])
	print "version" US typ["version"] US val["version"]
	print "lock" US typ["lock"] US clean(val["lock.byPhone"]) US val["lock.at"] US typ["lock.byPhone"] typ["lock.at"]
	print "changes" US typ["changes"]
	for (i = 1; i <= nc; i++) {
		p = cpath[i]
		print "change" US clean(val[p ".id"]) US val[p ".kind"] US (typ[p ".pkg"] == "s" ? clean(val[p ".pkg"]) : "") US clean(val[p ".from"]) US clean(val[p ".to"]) US clean(val[p ".byPhone"]) US val[p ".at"] US val[p ".verified"] US typ[p] typ[p ".id"] typ[p ".kind"] typ[p ".pkg"] typ[p ".from"] typ[p ".to"] typ[p ".byPhone"] typ[p ".at"] typ[p ".verified"]
	}
}
function upid(j) { if (match(j, /^\{"id":"[^"]*"/)) return substr(j, 8, RLENGTH - 8); return "" }
function okchange(j,  str) {
	str = "\"([^\"\\\\]|\\\\.)*\""
	return j ~ ("^[{]\"id\":" str ",\"kind\":\"[A-Z_]+\",\"pkg\":(null|" str "),\"from\":" str ",\"to\":" str ",\"byPhone\":" str ",\"at\":[0-9]+,\"verified\":(true|false)[}]$")
}
function oklock(j) { return j == "null" || j ~ /^[{]"byPhone":"([^"\\]|\\.)*","at":[0-9]+[}]$/ }
function okpoint(j) { return j ~ /^[{]"takenAt":[0-9]+,"byPhone":".*,"backgroundOps":[{].*[}][}]$/ }
function edit(  i, j, k, v, out, sep, ch, nd, drop, dropset, nu, ups, used, uid) {
	nd = split(ENVIRON["EXB_DROP"], drop, " "); for (i = 1; i <= nd; i++) dropset[drop[i]] = 1
	nu = split(ENVIRON["EXB_UPSERT"], ups, "\n")
	for (j = 1; j <= nu; j++) if (ups[j] != "" && !okchange(ups[j])) fail("refusing to write a damaged change")
	if (ENVIRON["EXB_LOCK"] != "" && !oklock(ENVIRON["EXB_LOCK"])) fail("refusing to write a damaged lock")
	if (ENVIRON["EXB_ORIGINAL"] != "" && !okpoint(ENVIRON["EXB_ORIGINAL"])) fail("refusing to write a damaged restore point")
	if (ENVIRON["EXB_LATEST"] != "" && !okpoint(ENVIRON["EXB_LATEST"])) fail("refusing to write a damaged restore point")
	ch = ""; sep = ""
	for (i = 1; i <= nc; i++) {
		uid = val[cpath[i] ".id"]
		if (uid in dropset) continue
		for (j = 1; j <= nu; j++) if (ups[j] != "" && upid(ups[j]) == uid) { craw[i] = ups[j]; used[j] = 1 }
		ch = ch sep craw[i]; sep = ","
	}
	for (j = 1; j <= nu; j++) if (ups[j] != "" && !(j in used)) { ch = ch sep ups[j]; sep = "," }
	if (!("changes" in raw)) { keys[++nk] = "changes"; rawkey["changes"] = "\"changes\"" }
	if (!("lock" in raw)) { keys[++nk] = "lock"; rawkey["lock"] = "\"lock\""; raw["lock"] = "null" }
	out = "{"; sep = ""
	for (i = 1; i <= nk; i++) {
		k = keys[i]; v = raw[k]
		if (k == "changes") v = "[" ch "]"
		else if (k == "lock" && ENVIRON["EXB_LOCK"] != "") v = ENVIRON["EXB_LOCK"]
		else if (k == "original" && v == "null" && ENVIRON["EXB_ORIGINAL"] != "") v = ENVIRON["EXB_ORIGINAL"]
		else if (k == "latest" && ENVIRON["EXB_LATEST"] != "") v = ENVIRON["EXB_LATEST"]
		out = out sep rawkey[k] ":" v; sep = ","
	}
	printf "%s}", out
}
BEGIN { mode = ENVIRON["EXB_MODE"]; US = "\037" }
{ s = s $0 "\n" }
END {
	n = length(s); pos = 1; nk = 0; nc = 0
	ws(); if (substr(s, pos, 1) != "{") fail("not a JSON object")
	pval("", 0); ws(); if (pos <= n) fail("text after the object")
	if (mode == "info") info()
	else if (mode == "edit") edit()
}'

json_run() { LC_ALL=C EXB_MODE=$1 awk "$JSON_AWK"; } # json_run flat|info|edit < json
json_flat() { json_run flat; }

# --- the TV's state file: lock + change log shared with the app (state/TvStateStore.kt) -----------------------------

fresh_state() { printf '{"version":1,"serial":%s,"original":null,"latest":null,"changes":[],"lock":null}' "$(json_str "$TV_SERIAL")"; }

# One change log entry, in kotlinx.serialization's field order. Args: id kind pkg(""=null) from to verified at.
change_json() {
	local pkg=null
	[ -n "$3" ] && pkg=$(json_str "$3")
	printf '{"id":%s,"kind":"%s","pkg":%s,"from":%s,"to":%s,"byPhone":%s,"at":%s,"verified":%s}' \
		"$(json_str "$1")" "$2" "$pkg" "$(json_str "$4")" "$(json_str "$5")" "$(json_str "$ME")" "$7" "$6"
}
lock_json() { printf '{"byPhone":%s,"at":%s}' "$(json_str "$ME")" "$(now_ms)"; }

# Parses ST_RAW into ST_STATUS (ok | notours | othertv | toonew), ST_LOCK_BY/ST_LOCK_AT and CH_* arrays (log order).
state_parse() {
	local tag a b c d e f g h sig line
	ST_LOCK_BY='' ST_LOCK_AT=0 NCH=0 ST_STATUS=ok
	CH_ID=() CH_KIND=() CH_PKG=() CH_FROM=() CH_BY=() CH_AT=() CH_VER=()
	printf '%s' "$ST_RAW" | json_run info >"$TMPD/state.info" 2>/dev/null
	case $? in
	0) ;;
	3) # the parser itself said this isn't a JSON object of our shape
		ST_STATUS=notours
		return 0
		;;
	*) return 1 ;; # the parser didn't finish: never treat the file as "not ours"
	esac
	while IFS=$US read -r tag a b c d e f g h sig; do
		case $tag in
		serial)
			[ "$a" = s ] || { ST_STATUS=notours && return 0; }
			ST_SERIAL=$b
			;;
		version)
			# Kotlin decodes a missing version as 1; a newer or unreadable one is never rewritten (TvStateTooNewException).
			if [ "$a" = s ] || { [ -n "$a" ] && { ! [[ $b =~ ^[0-9]+$ ]] || [ "$b" -gt "$STATE_VERSION" ]; }; }; then
				ST_STATUS=toonew
				return 0
			fi
			;;
		lock)
			case $a in
			o) if [ "$d" = sd ]; then ST_LOCK_BY=$b ST_LOCK_AT=${c%%.*}; else ST_STATUS=toonew; fi ;;
			n | '') ;;
			*) ST_STATUS=toonew ;;
			esac
			;;
		changes) [ -z "$a" ] || [ "$a" = a ] || ST_STATUS=toonew ;;
		change)
			line=$sig
			# Shape check, like kotlinx decoding: an object with string id/kind/from/to/byPhone, numeric at, boolean
			# verified, and a kind this version knows. Anything else was written by a newer app.
			if { [ "$line" != ossssssdb ] && [ "$line" != ossnsssdb ]; } || ! in_list "$b" "$KNOWN_KINDS"; then
				ST_STATUS=toonew
				return 0
			fi
			CH_ID[NCH]=$a CH_KIND[NCH]=$b CH_PKG[NCH]=$c CH_FROM[NCH]=$d CH_BY[NCH]=$f CH_AT[NCH]=${g%%.*} CH_VER[NCH]=$h
			NCH=$((NCH + 1))
			;;
		esac
	done <"$TMPD/state.info"
	[ "$ST_STATUS" = ok ] && [ "$ST_SERIAL" != "$TV_SERIAL" ] && ST_STATUS=othertv
	return 0
}

# Reads the state file. Returns 0 (ST_EXISTS=1/0), 1 unreadable, 2 no answer.
state_read() {
	tv_sh "cat $STATE_FILE" 30
	[ "$TV_RC" = 255 ] && return 2
	if [ "$TV_RC" != 0 ]; then
		case $TV_OUT in *"No such file"*)
			ST_EXISTS=0
			ST_RAW=$(fresh_state)
			state_parse
			return
			;;
		esac
		return 1
	fi
	ST_EXISTS=1
	ST_RAW=$TV_OUT
	state_parse || return 1
}

# Reads the state file before a change. Not ours, or written for another TV: set aside and start fresh (like the app).
# A newer version's file is never touched. Returns 0 ok, 1 failed, 2 no answer, 4 too new.
state_load() {
	state_read || return $?
	case $ST_STATUS in
	toonew) return 4 ;;
	notours | othertv)
		[ "$DRY" = 1 ] || {
			tv_sh "mv $STATE_FILE $STATE_FILE.bad-$(now_ms)"
			[ "$TV_RC" = 0 ] || return 1
		}
		ST_RAW=$(fresh_state)
		state_parse
		;;
	esac
	return 0
}

# Writes ST_RAW's edit atomically: base64 in chunks to a unique temp file, then mv. Never leaves the temp file behind.
state_save() { # state_save JSON "what (for --dry-run)"
	local b64 tmp first=1 chunk
	b64=$(printf '%s' "$1" | base64 | tr -d '\n')
	tmp="$STATE_FILE.tmp.$(now_ms)-$(rand_hex)"
	if [ "$DRY" = 1 ]; then
		printf '  %sadb -s %s shell "mkdir -p %s && echo <%s chars of base64> | base64 -d > %s && mv %s %s"   # %s%s\n' \
			"$C_DIM" "$SERIAL" "$STATE_DIR" "${#b64}" "$tmp" "$tmp" "$STATE_FILE" "$2" "$C_OFF"
		return 0
	fi
	if [ "${#b64}" -le "$CHUNK" ]; then
		tv_sh "mkdir -p $STATE_DIR && echo $b64 | base64 -d > $tmp && mv $tmp $STATE_FILE || { rm -f $tmp; false; }" 30
		[ "$TV_RC" = 0 ] && return 0
		[ "$TV_RC" = 255 ] && return 2
		return 1
	fi
	tv_sh "mkdir -p $STATE_DIR" 30
	[ "$TV_RC" = 0 ] || return 1
	while [ -n "$b64" ]; do
		chunk=${b64:0:$CHUNK}
		b64=${b64:$CHUNK}
		if [ "$first" = 1 ]; then tv_sh "echo $chunk | base64 -d > $tmp" 30; else tv_sh "echo $chunk | base64 -d >> $tmp" 30; fi
		first=0
		if [ "$TV_RC" != 0 ]; then
			tv_sh "rm -f $tmp" 10
			return 1
		fi
	done
	tv_sh "mv $tmp $STATE_FILE || { rm -f $tmp; false; }" 30
	[ "$TV_RC" = 0 ]
}

state_edit() { # env EXB_LOCK/EXB_DROP/EXB_UPSERT/EXB_ORIGINAL/EXB_LATEST → NEW_RAW
	NEW_RAW=$(printf '%s' "$ST_RAW" | json_run edit) && [ "${NEW_RAW:0:3}" != ERR ]
}

lock_fresh_other() { [ -n "$ST_LOCK_BY" ] && [ "$ST_LOCK_BY" != "$ME" ] && [ $(($(now_ms) - ST_LOCK_AT)) -lt "$LOCK_EXPIRY_MS" ]; }

# Takes the run lock as this computer (TvStateStore.acquireLock): refused if another phone holds a fresh lock; read
# back to confirm we won. Returns 0, 1 failed, 2 no answer, 3 locked (LOCKED_BY), 4 too new.
lock_acquire() {
	local rc
	state_load || return $?
	if lock_fresh_other; then
		LOCKED_BY=$ST_LOCK_BY
		return 3
	fi
	EXB_LOCK=$(lock_json) state_edit || return 1
	state_save "$NEW_RAW" "take the run lock" || return $?
	LOCK_HELD=1
	[ "$DRY" = 1 ] && return 0
	state_load
	rc=$?
	[ $rc = 0 ] || return $rc
	if [ "$ST_LOCK_BY" != "$ME" ]; then
		LOCKED_BY=${ST_LOCK_BY:-another phone}
		LOCK_HELD=0
		return 3
	fi
}

lock_release() {
	[ "$LOCK_HELD" = 1 ] || return 0
	LOCK_HELD=0
	if [ "$DRY" = 1 ]; then
		state_save "$ST_RAW" "release the run lock"
		return 0
	fi
	state_load || return 1
	[ "$ST_LOCK_BY" = "$ME" ] || return 0
	EXB_LOCK=null state_edit && state_save "$NEW_RAW" "release the run lock"
}

# Every change-log write also renews our lock; it refuses if another phone took the TV meanwhile.
log_write() { # log_write "what"   (env EXB_UPSERT / EXB_DROP)
	local rc
	if [ "$DRY" = 1 ]; then
		state_save "$ST_RAW" "$1"
		return 0
	fi
	state_load
	rc=$?
	[ $rc = 0 ] || return $rc
	if lock_fresh_other; then
		LOCKED_BY=$ST_LOCK_BY
		return 3
	fi
	EXB_LOCK=$(lock_json) state_edit || return 1
	state_save "$NEW_RAW" "$1"
}

# Write-ahead logging, as CleanupRunner: an unverified entry before the command, verified once the TV is read back,
# dropped if the TV shows nothing changed. A lost answer leaves it unverified ("maybe happened"; Undo reverses it).
log_begin() { # log_begin id kind pkg from to
	CUR_ID=$1 CUR_KIND=$2 CUR_PKG=$3 CUR_FROM=$4 CUR_TO=$5 CUR_AT=$(now_ms)
	EXB_UPSERT=$(change_json "$1" "$2" "$3" "$4" "$5" false "$CUR_AT") log_write "log $2 ${3:-} (not yet verified)"
}
log_confirm() { # [kind to]: settle as a different kind (a switch-off that became a removal, or the other way)
	[ -n "${1:-}" ] && CUR_KIND=$1 CUR_TO=$2
	EXB_UPSERT=$(change_json "$CUR_ID" "$CUR_KIND" "$CUR_PKG" "$CUR_FROM" "$CUR_TO" true "$CUR_AT") log_write "mark $CUR_KIND ${CUR_PKG:-} verified"
	CONFIRMED=$((CONFIRMED + 1))
}
log_rekind() { # an in-flight entry changes kind before its command (still unverified)
	CUR_KIND=$1 CUR_TO=$2
	EXB_UPSERT=$(change_json "$CUR_ID" "$CUR_KIND" "$CUR_PKG" "$CUR_FROM" "$CUR_TO" false "$CUR_AT") log_write "log $1 $CUR_PKG (not yet verified)"
}
log_discard() { EXB_DROP=$CUR_ID log_write "drop $CUR_KIND ${CUR_PKG:-} (nothing changed)"; }
log_drop() { EXB_DROP="$*" log_write "drop $# undone change(s)"; }

# --- finding the TV: scan the local /24 for ADB (5555), else cast/remote ports (Android TV with debugging off) -------

local_ipv4() {
	local ip='' ifc
	if command -v ip >/dev/null 2>&1; then
		ip=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}')
	fi
	if [ -z "$ip" ] && command -v route >/dev/null 2>&1 && command -v ipconfig >/dev/null 2>&1; then
		ifc=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')
		[ -n "$ifc" ] && ip=$(ipconfig getifaddr "$ifc" 2>/dev/null)
	fi
	if [ -z "$ip" ] && command -v ifconfig >/dev/null 2>&1; then
		ip=$(ifconfig 2>/dev/null | awk '/inet / {sub(/addr:/, "", $2); if ($2 !~ /^127\./) {print $2; exit}}')
	fi
	printf '%s' "$ip"
}

tcp_open() { (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null; }

probe_host() { # prints "ready" or "setup", or nothing
	local p pids='' hit=0
	if with_timeout 1 tcp_open "$1" 5555; then
		echo ready
		return
	fi
	for p in 6466 6467 8008 8009; do
		(with_timeout 1 tcp_open "$1" "$p" && touch "$2.$p") &
		pids="$pids $!"
	done
	# shellcheck disable=SC2086
	wait $pids
	for p in 6466 6467 8008 8009; do [ -f "$2.$p" ] && hit=1; done
	[ "$hit" = 1 ] && echo setup
}

# Scans PREFIX.1-254 (64 at a time). Fills HITS ("host:ready" / "host:setup").
scan_subnet() {
	local prefix=$1 self=$2 i h dir=$TMPD/scan running=0
	rm -rf "$dir"
	mkdir -p "$dir"
	HITS=()
	note "Looking for TVs on $prefix.0/24${self:+ (this computer is $self)}…"
	for i in $(seq 1 254); do
		h=$prefix.$i
		[ "$h" = "$self" ] && continue
		(probe_host "$h" "$dir/$h.p" >"$dir/$h") &
		running=$((running + 1))
		if [ "$running" -ge 64 ]; then
			wait
			running=0
		fi
	done
	wait
	for i in $(seq 1 254); do
		h=$prefix.$i
		[ -s "$dir/$h" ] && HITS[${#HITS[@]}]="$h:$(cat "$dir/$h")"
	done
	return 0
}

subnet_prefix() { # 192.168.1 from "192.168.1", "192.168.1.0/24" or an address
	local s=${1%/*} a b c
	IFS=. read -r a b c _ <<EOF
$s
EOF
	for x in "$a" "$b" "$c"; do [[ $x =~ ^[0-9]{1,3}$ ]] && [ "$x" -le 255 ] || return 1; done
	printf '%s.%s.%s' "$a" "$b" "$c"
}

print_hits() {
	local i=1 hit
	for hit in "${HITS[@]}"; do
		if [ "${hit##*:}" = ready ]; then
			printf '  %s%2d%s  %-16s %sReady%s\n' "$C_BOLD" "$i" "$C_OFF" "${hit%:*}" "$C_ACC" "$C_OFF"
		else
			printf '  %s%2d%s  %-16s %sSetup%s %s(turn on debugging first)%s\n' "$C_BOLD" "$i" "$C_OFF" "${hit%:*}" "$C_YEL" "$C_OFF" "$C_DIM" "$C_OFF"
		fi
		i=$((i + 1))
	done
}

cmd_scan() {
	local prefix self
	title "Find your TV"
	self=$(local_ipv4)
	if [ -n "$SUBNET" ]; then
		prefix=$(subnet_prefix "$SUBNET") || die "That doesn't look like a subnet. Use three numbers with dots, like 192.168.1"
	else
		[ -n "$self" ] || die "Couldn't find this computer's network address. Use --subnet 192.168.1"
		prefix=$(subnet_prefix "$self")
	fi
	scan_subnet "$prefix" "$self"
	if [ ${#HITS[@]} -eq 0 ]; then
		say "No TVs found."
		note "Make sure the TV is on and on the same network as this computer. Guest networks and some routers keep devices apart. Try your main Wi-Fi, or use --host with the TV's address (Settings > Network & Internet on the TV)."
		return 1
	fi
	print_hits
	note "Ready: debugging is on. Setup: an Android TV that needs debugging turned on first."
}

# --- turning on debugging: brand steps (ui/screens/BrandSteps.kt + strings.xml) -------------------------------------

BRANDS="Android TV|Google TV|Xiaomi Mi Box / Mi TV|TCL|Sony|Hisense|Philips|Fire TV"

brand_steps() { # brand_steps 1..8
	local s1 s2 s3
	local a1="Open Settings $G_ARROW Device Preferences $G_ARROW About" b1="Press OK on Build 7 times"
	local g1="Open Settings $G_ARROW System $G_ARROW About" g2="Press OK on Android TV OS build 7 times"
	local u="turn on USB debugging"
	case $1 in
	1) s1=$a1 s2=$b1 s3="Go back to Developer options and $u" ;;
	2) s1=$g1 s2=$g2 s3="Go back to System $G_ARROW Developer options and $u" ;;
	3 | 6) s1=$a1 s2=$b1 s3="Go back to Device Preferences $G_ARROW Developer options and $u" ;;
	4 | 5)
		s1="Open Settings $G_ARROW System $G_ARROW About (older TVs: Settings $G_ARROW Device Preferences $G_ARROW About)"
		s2="Press OK on Android TV OS build (older TVs: Build) 7 times" s3="Go back to Developer options and $u"
		;;
	7) s1="Open Settings $G_ARROW All settings $G_ARROW Android settings $G_ARROW Device Preferences $G_ARROW About" s2=$b1 s3="Go back to Developer options and $u" ;;
	8)
		s1="Open Settings $G_ARROW My Fire TV $G_ARROW About" s2="Press OK on your device's name (like Fire TV Stick) 7 times"
		s3="Go back to My Fire TV $G_ARROW Developer options and turn on the debugging switch"
		;;
	esac
	title "Turn on debugging"
	note "Grab the TV remote. This is a one-time setup."
	printf '  1  %s\n  2  %s\n  3  %s\n' "$s1" "$s2" "$s3"
	if [ "$1" = 8 ]; then
		note "On Fire TV the home screen stays as it is. Everything else works."
	else
		note "See Network debugging as well? Turn that on too."
	fi
	note "Only see Wireless debugging with a pairing code? This can't use that yet. Look for USB debugging instead."
}

show_steps() {
	local i=1 b
	title "Which TV do you have?"
	local IFS='|'
	for b in $BRANDS; do
		printf '  %d  %s\n' "$i" "$b"
		i=$((i + 1))
	done
	unset IFS
	ask "Pick a number [1]: " 1
	case $REPLY in [1-8]) ;; *) REPLY=1 ;; esac
	brand_steps "$REPLY"
}

# --- connecting and "Allow USB debugging?" --------------------------------------------------------------------------

adb_state() { "$ADB" devices 2>/dev/null | tr -d '\r' | awk -F'\t' -v s="$1" '$1 == s {print $2; exit}'; }

# adb connect HOST:PORT. CONNECT = ok | refused (debugging off) | unreachable | other.
adb_connect() {
	local out
	out=$(with_timeout 20 "$ADB" connect "$1" 2>&1 </dev/null)
	case $out in
	*"connected to"* | *"already connected"* | *"failed to authenticate"*) CONNECT=ok ;;
	*refused*) CONNECT=refused ;;
	*"timed out"* | *"No route"* | *unreachable* | '') CONNECT=unreachable ;;
	*) CONNECT=other CONNECT_MSG=$out ;;
	esac
}

# Waits up to 2 minutes for SERIAL to be "device", asking for "Allow USB debugging?" on the TV while it's unauthorized.
wait_for_device() {
	local start st said_allow=0 offline_since=0 t
	start=$(date +%s)
	while :; do
		st=$(adb_state "$SERIAL")
		t=$(($(date +%s) - start))
		case $st in
		device) return 0 ;;
		unauthorized)
			if [ "$said_allow" = 0 ]; then
				title "Allow on the TV"
				# shellcheck disable=SC1111 # the app's wording, curly quotes included
				say "Look at the TV and press OK on “Allow USB debugging?”. Tick “Always allow” first."
				note "Each computer has to be allowed once, even if a phone in your home was allowed before."
				note "Waiting for you to press OK on the TV…"
				said_allow=1
			fi
			;;
		offline)
			[ "$offline_since" = 0 ] && offline_since=$t
			if [ $((t - offline_since)) -ge 5 ] && [ -n "$HOST" ]; then
				"$ADB" disconnect "$SERIAL" >/dev/null 2>&1
				adb_connect "$SERIAL"
				offline_since=0
			fi
			;;
		*) [ -n "$HOST" ] && [ $((t % 5)) = 0 ] && adb_connect "$SERIAL" ;;
		esac
		if [ "$t" -ge 120 ]; then
			if [ "$said_allow" = 1 ]; then
				bad "The TV didn't answer."
				note "Nobody pressed OK on the TV in time, or the message closed. Make sure the TV is on, then try again."
			elif [ "$st" = offline ]; then
				bad "The TV is connected but offline. Restart the TV, then try again."
			else
				bad "Can't reach the TV. Make sure it's on and on the same Wi-Fi."
			fi
			return 1
		fi
		sleep 1
	done
}

# Connects to HOST (a network TV) until it's ready, with the setup steps when debugging is off.
connect_host() {
	local hp=$1
	case $hp in *:*) ;; *) hp=$hp:5555 ;; esac
	SERIAL=$hp
	while :; do
		note "Connecting to $hp…"
		adb_connect "$hp"
		case $CONNECT in
		ok) wait_for_device && return 0 ;;
		refused)
			say "The TV answered, but debugging is off."
			show_steps
			;;
		unreachable) bad "Can't reach the TV at ${hp%:*}. Make sure it's on and on the same Wi-Fi." ;;
		*) bad "adb couldn't connect: $CONNECT_MSG" ;;
		esac
		ask "Press Enter to try again, s for the setup steps, or q to quit: " ''
		case $REPLY in
		q | Q) exit 1 ;;
		s | S) show_steps && ask "Press Enter once debugging is on: " '' ;;
		esac
	done
}

# Finds and connects to the TV: --serial, --host, the last TV, or a scan.
connect_tv() {
	local last_host last_name prefix self i
	if [ -n "$SERIAL_ARG" ]; then
		SERIAL=$SERIAL_ARG
		[ -n "$(adb_state "$SERIAL")" ] || die "adb doesn't know a device called $SERIAL (see: adb devices)."
		wait_for_device || exit 1
		return 0
	fi
	if [ -n "$HOST_ARG" ]; then
		HOST=$HOST_ARG
		connect_host "$HOST"
		return 0
	fi
	last_host=$(conf_get last-tv host)
	last_name=$(conf_get last-tv name)
	while :; do
		title "Find your TV"
		if [ -n "$last_host" ]; then
			ask "Use your last TV, ${last_name:-Android TV} at $last_host? [Y/n] " y
			case $REPLY in
			y | Y | yes)
				HOST=$last_host
				connect_host "$HOST"
				return 0
				;;
			esac
		fi
		self=$(local_ipv4)
		if [ -n "$SUBNET" ]; then
			prefix=$(subnet_prefix "$SUBNET") || die "That doesn't look like a subnet. Use three numbers with dots, like 192.168.1"
		elif [ -n "$self" ]; then
			prefix=$(subnet_prefix "$self")
		else
			prefix=''
		fi
		HITS=()
		[ -n "$prefix" ] && scan_subnet "$prefix" "$self"
		if [ ${#HITS[@]} -gt 0 ]; then
			print_hits
			ask "Pick a TV by number, or type its IP address (r to look again, q to quit): " 1
		else
			say "No TVs found."
			note "Make sure the TV is on and on the same network as this computer. On the TV, open Settings, then Network & Internet, and look for the IP address, like 192.168.1.20."
			ask "Type the TV's IP address (r to look again, q to quit): " r
		fi
		case $REPLY in
		q | Q) exit 1 ;;
		r | R) continue ;;
		esac
		if [[ $REPLY =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#HITS[@]} ]; then
			i=$((REPLY - 1))
			HOST=${HITS[i]%:*}
			[ "${HITS[i]##*:}" = setup ] && say "This TV needs debugging turned on first." && show_steps && ask "Press Enter once debugging is on: " ''
		elif [[ $REPLY =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]+)?$ ]]; then
			HOST=$REPLY
		else
			bad "That doesn't look right. It should be four numbers with dots, like 192.168.1.20."
			continue
		fi
		connect_host "$HOST"
		return 0
	done
}

# --- reading the TV (tv/TvInspector.kt) and grouping its apps (catalog/Categorizer.kt) ------------------------------

INV_SCRIPT="echo @@props; getprop ro.serialno; getprop ro.boot.serialno; getprop ro.product.model; getprop ro.product.brand; getprop ro.product.manufacturer; getprop ro.build.version.release; getprop ro.build.version.sdk
echo @@all; pm list packages
echo @@sys; pm list packages -s
echo @@dis; pm list packages -d
echo @@u; pm list packages -u
echo @@leanback; ${QUERY}LEANBACK_LAUNCHER
echo @@launcher; ${QUERY}LAUNCHER
echo @@home; ${QUERY}HOME
echo @@resolved; $RESOLVE_HOME
echo @@anim; settings get global window_animation_scale; settings get global transition_animation_scale; settings get global animator_duration_scale
echo @@end"

read_inventory() {
	local d=$TMPD/inv sec f p
	rm -rf "$d"
	mkdir -p "$d"
	tv_sh "$INV_SCRIPT" 180
	[ "$TV_RC" = 255 ] && die "Can't reach the TV. Make sure it's on and on the same Wi-Fi."
	for sec in props all sys dis u leanback launcher home resolved anim; do : >"$d/$sec"; done
	printf '%s\n' "$TV_OUT" | awk -v d="$d" '/^@@[a-z]+$/ {sec = substr($0, 3); next} sec != "" && sec != "end" {print > (d "/" sec)}'
	for sec in all sys dis u; do
		pm_error "$(cat "$d/$sec")" && die "Couldn't read the TV (app list). Try again."
		sed -n 's/^package://p' "$d/$sec" | sort -u >"$d/$sec.list"
	done
	[ -s "$d/all.list" ] || die "Couldn't read the TV (app list): no apps returned."
	[ -s "$d/sys.list" ] || die "Couldn't read the TV (system app list): no apps returned."
	{
		read -r p_serial
		read -r p_bootserial
		read -r TV_MODEL
		read -r _
		read -r TV_MANUFACTURER
		read -r TV_RELEASE
		read -r TV_SDK
	} <"$d/props"
	TV_SERIAL=${p_serial:-${p_bootserial:-unknown-$TV_MODEL}}
	[[ $TV_SDK =~ ^[0-9]+$ ]] || TV_SDK=0
	comm -23 "$d/u.list" "$d/all.list" >"$d/removed.list"
	{ home_pkgs_from "$(cat "$d/leanback")"; home_pkgs_from "$(cat "$d/launcher")"; } | sort -u >"$d/launchable.list"
	[ -s "$d/launchable.list" ] || die "Couldn't read the TV (launchable apps): none found."
	home_pkgs_from "$(cat "$d/home")" >"$d/home.list"
	TV_HOME=$(resolved_from "$(cat "$d/resolved")")
	ACTIVE_LAUNCHER=${TV_HOME%%/*}
	ANIM_RAW=()
	while read -r f; do
		[ "$f" = null ] || [[ $f =~ ^-?[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$ ]] || die "Couldn't read the TV (animation settings): unexpected value '$f'."
		ANIM_RAW[${#ANIM_RAW[@]}]=$f
	done <"$d/anim"
	[ ${#ANIM_RAW[@]} = 3 ] || die "Couldn't read the TV (animation settings)."
	# Background setting of apps the person installed that can be opened (TvInspector.backgroundOps).
	: >"$d/bgops"
	p=$(comm -23 "$d/launchable.list" "$d/sys.list" | comm -12 - "$d/all.list" | tr '\n' ' ')
	if [ -n "$p" ]; then
		tv_sh "for p in $p; do echo @@\$p; cmd appops get \$p RUN_ANY_IN_BACKGROUND; done" 120
		[ "$TV_RC" = 0 ] && printf '%s\n' "$TV_OUT" | awk '/^@@/ {p = substr($0, 3); next} p != "" && match($0, /^[ \t]*RUN_ANY_IN_BACKGROUND:[ \t]*[A-Za-z0-9_]+/) {v = substr($0, RSTART, RLENGTH); sub(/.*:[ \t]*/, "", v); print p "\t" v; p = ""}' >"$d/bgops"
	fi
	categorize
}

# The Categorizer in awk: SafetyGuard first (always system), then the catalog (exact beats glob, longest glob wins),
# then home screens, then system vs "Other". Sorted by category, then name. Fills the A_* arrays.
categorize() {
	local d=$TMPD/inv i
	{
		catalog_tsv | awk '{print "C\037" $0}'
		never_disable | awk '{print "N\037" $0}'
		remote_input | awk '{print "R\037" $0}'
		awk '{print "S\037" $0}' "$d/sys.list"
		awk '{print "D\037" $0}' "$d/dis.list"
		awk '{print "L\037" $0}' "$d/launchable.list"
		awk '{print "H\037" $0}' "$d/home.list"
		awk -F'\t' '{print "B\037" $1 "\037" $2}' "$d/bgops"
		awk '{print "P\037" $0 "\037" 0}' "$d/all.list"
		awk '{print "P\037" $0 "\037" 1}' "$d/removed.list"
	} | LC_ALL=C awk -F'\037' -v OFS='\037' '
	function glob(g, s,   parts, np, i, at, k, last) {
		if (index(g, "*") == 0) return g == s
		np = split(g, parts, "*")
		if (substr(s, 1, length(parts[1])) != parts[1]) return 0
		at = length(parts[1]) + 1
		for (i = 2; i < np; i++) { if (parts[i] == "") continue; k = index(substr(s, at), parts[i]); if (!k) return 0; at += k - 1 + length(parts[i]) }
		last = parts[np]
		if (length(s) - at + 1 < length(last)) return 0
		return substr(s, length(s) - length(last) + 1) == last
	}
	function anyglob(list, cnt, s,   i) { for (i = 1; i <= cnt; i++) if (glob(list[i], s)) return 1; return 0 }
	function pretty(p,   l) { l = p; sub(/.*\./, "", l); if (l == "") l = p; gsub(/_/, " ", l); return toupper(substr(l, 1, 1)) substr(l, 2) }
	BEGIN { split("STREAMING MUSIC LIVE_TV FEATURES GOOGLE_EXTRAS MANUFACTURER ADS_TRACKING SIDELOAD_TOOLS OTHER SYSTEM LAUNCHER", cats, " "); for (i in cats) ord[cats[i]] = i - 1 }
	$1 == "C" {
		if (index($2, "*")) { ng++; gp[ng] = $2; gl[ng] = $0 } else ex[$2] = $0
		next
	}
	$1 == "N" { nv[++nn] = $2; next }
	$1 == "R" { rm[++nr] = $2; next }
	$1 == "S" { sys[$2] = 1; next }
	$1 == "D" { dis[$2] = 1; next }
	$1 == "L" { lau[$2] = 1; next }
	$1 == "H" { home[$2] = 1; next }
	$1 == "B" { bg[$2] = $3; next }
	$1 == "P" { pk[++np] = $2; removed[$2] = $3; next }
	END {
		# Longest glob first (stable), like Catalog.
		for (i = 2; i <= ng; i++) { p = gp[i]; l = gl[i]; for (j = i - 1; j >= 1 && length(gp[j]) < length(p); j--) { gp[j + 1] = gp[j]; gl[j + 1] = gl[j] } gp[j + 1] = p; gl[j + 1] = l }
		for (i = 1; i <= np; i++) {
			p = pk[i]; e = ""
			if (p in ex) e = ex[p]
			else for (j = 1; j <= ng; j++) if (glob(gp[j], p)) { e = gl[j]; break }
			n = split(e, f, "\037")
			isrem = anyglob(rm, nr, p)
			issys = (removed[p] == 1) ? 1 : (p in sys) ? 1 : 0
			en = (removed[p] == 1) ? 0 : (p in dis) ? 0 : 1
			if (isrem || anyglob(nv, nn, p)) { cat = "SYSTEM"; name = (e != "" ? f[4] : pretty(p)); desc = (e != "" ? f[5] : ""); keep = 1; lock = 1; mus = 0 }
			else if (e != "") { cat = f[3]; name = f[4]; desc = f[5]; keep = f[6]; lock = f[7]; mus = f[8] }
			else if (p in home) { cat = "LAUNCHER"; name = pretty(p); desc = "A home screen app"; keep = 1; lock = 1; mus = 0 }
			else if (issys) { cat = "SYSTEM"; name = pretty(p); desc = ""; keep = 1; lock = 1; mus = 0 }
			else { cat = "OTHER"; name = pretty(p); desc = ""; keep = 1; lock = 0; mus = 0 }
			print ord[cat], tolower(name), p, cat, name, desc, keep, lock, mus, (p in lau) ? 1 : 0, issys, en, removed[p] + 0, isrem, (p in bg) ? bg[p] : ""
		}
	}' | LC_ALL=C sort -t "$US" -k1,1n -k2,2 -k3,3 | cut -d "$US" -f 3- >"$TMPD/apps"
	local pkg cat name desc dk lk mu la sy en rm re bg
	N=0
	A_PKG=() A_CAT=() A_NAME=() A_DESC=() A_DKEEP=() A_LOCK=() A_MUSIC=() A_LAUNCH=() A_SYS=() A_EN=() A_REM=() A_REMOTE=() A_BG=()
	while IFS=$US read -r pkg cat name desc dk lk mu la sy en rm re bg; do
		A_PKG[N]=$pkg A_CAT[N]=$cat A_NAME[N]=$name A_DESC[N]=$desc A_DKEEP[N]=$dk A_LOCK[N]=$lk A_MUSIC[N]=$mu
		A_LAUNCH[N]=$la A_SYS[N]=$sy A_EN[N]=$en A_REM[N]=$rm A_REMOTE[N]=$re A_BG[N]=$bg
		N=$((N + 1))
	done <"$TMPD/apps"
	# Starting switches (defaultChoices): locked rows use their default; others are on only if on now and kept by default.
	KEEP=()
	for ((i = 0; i < N; i++)); do
		if [ "${A_LOCK[i]}" = 1 ]; then KEEP[i]=${A_DKEEP[i]}; elif [ "${A_EN[i]}" = 1 ] && [ "${A_DKEEP[i]}" = 1 ]; then KEEP[i]=1; else KEEP[i]=0; fi
	done
}

cat_label() {
	case $1 in
	STREAMING) echo "Streaming video" ;; MUSIC) echo "Music & audio" ;; LIVE_TV) echo "Live TV & sports" ;;
	FEATURES) echo "Features" ;; GOOGLE_EXTRAS) echo "Google extras" ;; MANUFACTURER) echo "Manufacturer extras" ;;
	SIDELOAD_TOOLS) echo "Store & sideload tools" ;; OTHER) echo "Other" ;; ADS_TRACKING) echo "Ads & tracking" ;;
	SYSTEM) echo "System" ;; LAUNCHER) echo "Home screens" ;; *) echo "$1" ;;
	esac
}
is_switch() { [ "${A_REMOTE[$1]}" != 1 ] && [ "${A_LOCK[$1]}" != 1 ] && in_list "${A_CAT[$1]}" "$KEEP_GROUPS"; }
tv_label() { printf '%s' "${TV_MODEL:-Android TV}${TV_RELEASE:+ $G_DOT Android $TV_RELEASE}"; }

# --- choosing what to keep: a keyboard checklist on a terminal, a numbered list otherwise --------------------------

# Display lines: "h:CAT" group header, "r:i" switch row, "l:i" locked row, "t:text" hint.
build_lines() {
	local cat i ads=0
	DL=()
	SEL=()
	for cat in $KEEP_GROUPS; do
		local first=1
		for ((i = 0; i < N; i++)); do
			[ "${A_CAT[i]}" = "$cat" ] && [ "${A_REMOTE[i]}" != 1 ] || continue
			if [ "$first" = 1 ]; then
				[ ${#DL[@]} -gt 0 ] && DL[${#DL[@]}]="t:"
				DL[${#DL[@]}]="h:$cat"
				[ "$cat" = OTHER ] && DL[${#DL[@]}]="t:Apps you installed that this app doesn't know yet."
				first=0
			fi
			if is_switch "$i"; then
				SEL[${#SEL[@]}]=${#DL[@]}
				DL[${#DL[@]}]="r:$i"
			else
				DL[${#DL[@]}]="l:$i"
			fi
		done
	done
	for ((i = 0; i < N; i++)); do [ "${A_CAT[i]}" = ADS_TRACKING ] && [ "${A_REMOTE[i]}" != 1 ] && ads=$((ads + 1)); done
	if [ "$ads" -gt 0 ]; then
		DL[${#DL[@]}]="t:"
		DL[${#DL[@]}]="h:ADS_TRACKING"
		DL[${#DL[@]}]="t:These show ads or track what you watch, so they're always switched off."
		for ((i = 0; i < N; i++)); do [ "${A_CAT[i]}" = ADS_TRACKING ] && [ "${A_REMOTE[i]}" != 1 ] && DL[${#DL[@]}]="l:$i"; done
	fi
}

count_off() {
	local i n=0
	for ((i = 0; i < N; i++)); do
		[ "${A_CAT[i]}" = SYSTEM ] || [ "${A_CAT[i]}" = LAUNCHER ] || [ "${A_REMOTE[i]}" = 1 ] && continue
		[ "${KEEP[i]}" = 0 ] && n=$((n + 1))
	done
	OFF_COUNT=$n
}

toggle_group() { # toggle every switch in row i's group: all on unless they already all are
	local cat=${A_CAT[$1]} i all=1
	for ((i = 0; i < N; i++)); do [ "${A_CAT[i]}" = "$cat" ] && is_switch "$i" && [ "${KEEP[i]}" = 0 ] && all=0; done
	for ((i = 0; i < N; i++)); do [ "${A_CAT[i]}" = "$cat" ] && is_switch "$i" && KEEP[i]=$((1 - all)); done
}

group_summary() { # "3 of 5 kept"
	local cat=$1 i k=0 t=0
	for ((i = 0; i < N; i++)); do
		[ "${A_CAT[i]}" = "$cat" ] && [ "${A_REMOTE[i]}" != 1 ] || continue
		t=$((t + 1))
		[ "${KEEP[i]}" = 1 ] && k=$((k + 1))
	done
	if [ "$cat" = ADS_TRACKING ]; then printf 'Always switched off (%d)' "$t"; else printf '%d of %d kept' "$k" "$t"; fi
}

fit() { # fit TEXT WIDTH: cut to width with an ellipsis
	local s=$1 w=$2
	[ "$w" -le 0 ] && return 0
	if [ ${#s} -gt "$w" ]; then
		if [ "$w" -gt 1 ]; then s="${s:0:$((w - 1))}${G_RUN:0:1}"; else s=${s:0:$w}; fi
	fi
	printf '%s' "$s"
}

tui_size() {
	local sz
	sz=$(stty size </dev/tty 2>/dev/null)
	ROWS=${sz% *} COLS=${sz#* }
	[[ $ROWS =~ ^[0-9]+$ ]] || ROWS=24
	[[ $COLS =~ ^[0-9]+$ ]] || COLS=80
}

tui_draw() {
	local body=$((ROWS - 5)) out e kind i line name box mark w nw left right
	out=$'\033[H'
	if [ "$ROWS" -lt 8 ] || [ "$COLS" -lt 40 ]; then
		printf '%s%s\033[K\n%s\033[J' "$out" "$(fit "Make the terminal bigger to choose apps." "$COLS")" "$(fit "q quits" "$COLS")"
		return
	fi
	CUR_LINE=${SEL[CUR]:-0}
	[ "$CUR_LINE" -lt "$TOP" ] && TOP=$CUR_LINE
	[ "$CUR_LINE" -ge $((TOP + body)) ] && TOP=$((CUR_LINE - body + 1))
	[ "$TOP" -gt 0 ] && [ "$CUR_LINE" -le 2 ] && TOP=0
	left="$G_BAR ExBloat TV $G_DOT Keep what you watch"
	right=$(tv_label)
	w=$((COLS - ${#left} - 2))
	[ "$w" -lt 0 ] && w=0
	out+="$C_ACC$C_BOLD$(fit "$left" "$COLS")$C_OFF"
	[ "$w" -gt 3 ] && out+="  $C_DIM$(printf '%*s' "$w" "$(fit "$right" "$w")")$C_OFF"
	out+=$'\033[K\n'
	out+="$C_DIM$(fit "The rest gets switched off. Undo any time." "$COLS")$C_OFF"$'\033[K\n\033[K\n'
	for ((line = TOP; line < TOP + body; line++)); do
		e=${DL[line]:-}
		kind=${e%%:*} i=${e#*:}
		case $kind in
		h) out+="$C_BOLD$(fit "$(cat_label "$i")" 30)$C_OFF  $C_DIM$(group_summary "$i")$C_OFF" ;;
		t) out+="$C_DIM$(fit "  $i" "$COLS")$C_OFF" ;;
		r | l)
			if [ "$kind" = r ]; then
				if [ "${KEEP[i]}" = 1 ]; then box=$G_ON; else box=$G_OFF; fi
			elif [ "${KEEP[i]}" = 1 ]; then box=$G_LOCKON; else box=$G_LOCKOFF; fi
			mark=' '
			[ "$line" = "$CUR_LINE" ] && mark=$G_CUR
			nw=28
			[ $((COLS - 8)) -lt "$nw" ] && nw=$((COLS - 8))
			name=$(fit "${A_NAME[i]}" "$nw")
			local desc=${A_DESC[i]}
			[ "$kind" = l ] && [ -z "$desc" ] && [ "${KEEP[i]}" = 1 ] && desc="Always kept"
			if [ "$line" = "$CUR_LINE" ]; then
				out+="$C_ACC$C_BOLD $mark $box $name$C_OFF"
			elif [ "$kind" = l ]; then
				out+="$C_DIM   $box $name$C_OFF"
			else
				out+="   $box $name"
			fi
			w=$((COLS - 8 - nw - 2))
			[ "$w" -gt 4 ] && out+="$(printf '%*s' $((nw - ${#name})) '')  $C_DIM$(fit "$desc" "$w")$C_OFF"
			;;
		esac
		out+=$'\033[K\n'
	done
	count_off
	out+=$'\033[K\n'
	line="$(fit "$OFF_COUNT switched off $G_DOT ↑↓/jk move $G_DOT space switch $G_DOT a whole group $G_DOT enter review $G_DOT q quit" "$COLS")"
	[ "$UTF" = 1 ] || line=$(fit "$OFF_COUNT switched off - up/down/jk move - space switch - a group - enter review - q quit" "$COLS")
	out+="$C_DIM$line$C_OFF"$'\033[K\033[J'
	printf '%s' "$out"
}

tui_restore() {
	[ "$TUI_ON" = 1 ] || return 0
	TUI_ON=0
	printf '\033[?25h\033[?1049l'
	[ -n "$STTY_SAVED" ] && stty "$STTY_SAVED" </dev/tty 2>/dev/null
	trap - WINCH
}

tui_choose() {
	local k k2 k3 i
	build_lines
	[ ${#SEL[@]} -gt 0 ] || return 0
	CUR=0 TOP=0
	STTY_SAVED=$(stty -g </dev/tty 2>/dev/null)
	TUI_ON=1
	printf '\033[?1049h\033[?25l'
	stty -echo </dev/tty 2>/dev/null
	tui_size
	trap 'tui_size; tui_draw' WINCH
	while :; do
		tui_draw
		IFS= read -rsn1 k </dev/tty || break
		if [ "$k" = $'\033' ]; then
			k2='' k3=''
			IFS= read -rsn2 -t 1 k2 </dev/tty
			case $k2 in '[5' | '[6') IFS= read -rsn1 -t 1 k3 </dev/tty ;; esac
			k="$k$k2$k3"
		fi
		case $k in
		k | $'\033[A' | $'\033OA') [ "$CUR" -gt 0 ] && CUR=$((CUR - 1)) ;;
		j | $'\033[B' | $'\033OB') [ "$CUR" -lt $((${#SEL[@]} - 1)) ] && CUR=$((CUR + 1)) ;;
		$'\033[5~') CUR=$((CUR - ROWS / 2)) && [ "$CUR" -lt 0 ] && CUR=0 ;;
		$'\033[6~') CUR=$((CUR + ROWS / 2)) && [ "$CUR" -ge ${#SEL[@]} ] && CUR=$((${#SEL[@]} - 1)) ;;
		g | $'\033[H') CUR=0 ;;
		G | $'\033[F') CUR=$((${#SEL[@]} - 1)) ;;
		' ' | x)
			i=${DL[${SEL[CUR]}]#r:}
			KEEP[i]=$((1 - KEEP[i]))
			;;
		a)
			i=${DL[${SEL[CUR]}]#r:}
			toggle_group "$i"
			;;
		'' | $'\n' | $'\r') break ;;
		q | Q)
			tui_restore
			say "Nothing was changed."
			exit 0
			;;
		esac
	done
	tui_restore
}

plain_choose() {
	local e kind i n line tok num map=() last_group
	build_lines
	while :; do
		title "Keep what you watch"
		note "The rest gets switched off. Undo any time."
		n=0
		for e in "${DL[@]}"; do
			kind=${e%%:*} i=${e#*:}
			case $kind in
			h) printf '\n%s%s%s  %s%s%s\n' "$C_BOLD" "$(cat_label "$i")" "$C_OFF" "$C_DIM" "$(group_summary "$i")" "$C_OFF" ;;
			t) [ -n "$i" ] && note "  $i" ;;
			r)
				n=$((n + 1))
				map[n]=$i
				if [ "${KEEP[i]}" = 1 ]; then e=$G_ON; else e=$G_OFF; fi
				printf '  %3d %s %s%s\n' "$n" "$e" "${A_NAME[i]}" "${A_DESC[i]:+  $C_DIM${A_DESC[i]}$C_OFF}"
				;;
			l)
				if [ "${KEEP[i]}" = 1 ]; then e=$G_LOCKON; else e=$G_LOCKOFF; fi
				printf '      %s%s %s%s\n' "$C_DIM" "$e" "${A_NAME[i]}" "$C_OFF"
				;;
			esac
		done
		count_off
		printf '\n%s apps will be switched off.\n' "$OFF_COUNT"
		[ "$n" -gt 0 ] || return 0
		ask "Numbers to switch (e.g. 3 7 12), \"a 3\" for 3's whole group, Enter to review, q to quit: " ''
		line=$REPLY
		case $line in '') return 0 ;; q | Q)
			say "Nothing was changed."
			exit 0
			;;
		esac
		last_group=0
		for tok in $line; do
			case $tok in
			a | A) last_group=1 ;;
			*)
				if [[ $tok =~ ^[0-9]+$ ]] && [ "$tok" -ge 1 ] && [ "$tok" -le "$n" ]; then
					num=${map[tok]}
					if [ "$last_group" = 1 ]; then toggle_group "$num"; else KEEP[num]=$((1 - KEEP[num])); fi
				else
					warn "Skipped \"$tok\": not a number from the list."
				fi
				last_group=0
				;;
			esac
		done
	done
}

# --- planning (cleanup/CleanupPlanner.kt): the steps that take the TV from now to the switches ----------------------

plan_build() {
	local i keep removals=() restores=() background=() a
	STEPS=()
	for ((i = 0; i < N; i++)); do
		[ "${A_CAT[i]}" = LAUNCHER ] || [ "${A_CAT[i]}" = SYSTEM ] && continue
		if [ "${A_LOCK[i]}" = 1 ]; then keep=${A_DKEEP[i]}; else keep=${KEEP[i]}; fi
		if [ "$keep" = 1 ]; then
			if [ "${A_REM[i]}" = 1 ]; then
				restores[${#restores[@]}]="install-existing $i"
			elif [ "${A_EN[i]}" = 0 ]; then
				restores[${#restores[@]}]="enable $i"
			elif [ "$OPT_BG" = 1 ] && [ "${A_LAUNCH[i]}" = 1 ] && [ "${A_MUSIC[i]}" != 1 ] &&
				{ [ "${A_CAT[i]}" = STREAMING ] || [ "${A_CAT[i]}" = LIVE_TV ]; } && [ "${A_BG[i]}" != ignore ]; then
				background[${#background[@]}]="background $i"
			fi
		elif [ "${A_REM[i]}" != 1 ] && [ "${A_EN[i]}" = 1 ] && ! safety_protected "${A_PKG[i]}" && [ "${A_PKG[i]}" != "$ACTIVE_LAUNCHER" ]; then
			# Removing for the TV's user is only for apps that came with the TV: for an app the person installed it
			# would delete it, so those are switched off whichever way is picked.
			if [ "$OPT_REMOVE" = 1 ] && [ "${A_SYS[i]}" = 1 ]; then removals[${#removals[@]}]="remove $i"; else removals[${#removals[@]}]="disable $i"; fi
		fi
	done
	STEPS=("${removals[@]}" "${restores[@]}" "${background[@]}")
	if [ "$OPT_ANIM" = 1 ]; then
		for a in "${ANIM_RAW[@]}"; do
			if [ "$(scale_value "$a")" != "$FAST" ]; then
				STEPS[${#STEPS[@]}]=animations
				break
			fi
		done
	fi
	[ "$OPT_TRIM" = 1 ] && STEPS[${#STEPS[@]}]=trim
	SWAP_PLANNED=0
	if swap_available && [ "$OPT_HOME" = 1 ] && [ "$ACTIVE_LAUNCHER" != "$FLAUNCHER_PKG" ]; then
		STEPS[${#STEPS[@]}]=swap
		SWAP_PLANNED=1
	fi
	if [ "$SWAP_PLANNED" = 1 ] || [ ${#removals[@]} -gt 0 ]; then STEPS[${#STEPS[@]}]=reboot; fi
	return 0
}

swap_available() { [ "$(lower "$TV_MANUFACTURER")" != amazon ]; }
scale_value() { if [ "$1" = null ]; then echo 1; else awk -v v="$1" 'BEGIN {printf "%g", v + 0}'; fi; } # never set = 1.0

step_text() {
	local kind=${1%% *} i=${1#* }
	case $kind in
	disable) printf 'Switch off %s' "${A_NAME[i]}" ;;
	remove) printf 'Remove %s for the TV'"'"'s user' "${A_NAME[i]}" ;;
	enable) printf 'Switch on %s' "${A_NAME[i]}" ;;
	install-existing) printf 'Bring back %s' "${A_NAME[i]}" ;;
	background) printf 'Stop %s running in the background' "${A_NAME[i]}" ;;
	animations) printf 'Make menus and screens snappier (%s)' "$([ "$UTF" = 1 ] && echo '0.5×' || echo '0.5x')" ;;
	trim) printf 'Clear temporary files' ;;
	swap) printf 'Set up the new home screen (FLauncher)' ;;
	reboot) printf 'Restart and check everything still works' ;;
	esac
}

plural() { if [ "$1" = 1 ]; then printf '%s' "$2"; else printf '%s' "$3"; fi; }

# --- review: what will happen, the speed options, and an explicit yes ----------------------------------------------

review() {
	local s off rem on names
	while :; do
		plan_build
		off=0 rem=0 on=0 names=''
		for s in "${STEPS[@]}"; do
			case ${s%% *} in
			disable) off=$((off + 1)) names="$names, ${A_NAME[${s#* }]}" ;;
			remove) rem=$((rem + 1)) names="$names, ${A_NAME[${s#* }]}" ;;
			enable | install-existing) on=$((on + 1)) ;;
			esac
		done
		title "Ready to clean up"
		if [ ${#STEPS[@]} = 0 ]; then
			say "Your TV already matches your choices. Nothing to change."
		fi
		if [ "$off" -gt 0 ]; then
			if [ "$SWAP_PLANNED" = 1 ]; then
				say "$off $(plural "$off" "app" "apps") will be switched off (plus the old home screen)."
			else
				say "$off $(plural "$off" "app" "apps") will be switched off."
			fi
		elif [ "$SWAP_PLANNED" = 1 ]; then
			say "The old home screen will be switched off."
		fi
		[ "$rem" -gt 0 ] && say "$rem $(plural "$rem" "app" "apps") will be removed for the TV's user (data kept; Undo brings them back)."
		[ -n "$names" ] && note "  ${names#, }"
		[ "$on" -gt 0 ] && say "$on $(plural "$on" "app" "apps") will be switched back on."
		[ "$SWAP_PLANNED" = 1 ] && say "The home screen will change to FLauncher."
		in_list reboot "${STEPS[*]}" && say "The TV will restart once at the end."
		[ ${#STEPS[@]} -gt 0 ] && note "Leave the remote alone for a couple of minutes."
		printf '\n%sMake it faster%s\n' "$C_BOLD" "$C_OFF"
		opt_line 1 "$OPT_ANIM" "Faster animations" "Menus and screens open quicker"
		opt_line 2 "$OPT_BG" "Stop video apps running in the background" "Frees memory. Music apps keep playing."
		opt_line 3 "$OPT_TRIM" "Clear app caches" "Removes temporary files"
		if swap_available; then
			opt_line 4 "$OPT_HOME" "New home screen (FLauncher)" "A simple home screen without ads"
		else
			printf '   %s4 %s New home screen (FLauncher)  Not available on Fire TV yet%s\n' "$C_DIM" "$G_OFF" "$C_OFF"
		fi
		opt_line 5 "$OPT_REMOVE" "Remove instead of switching off" "pm uninstall -k --user 0 for apps that came with the TV"
		[ "$YES" = 1 ] && return 0
		if [ ${#STEPS[@]} = 0 ]; then
			ask $'\nNumber to change an option, or Enter to finish: ' ''
		else
			ask $'\nNumber to change an option, Enter to go on, q to quit: ' ''
		fi
		case $REPLY in
		1) OPT_ANIM=$((1 - OPT_ANIM)) ;; 2) OPT_BG=$((1 - OPT_BG)) ;; 3) OPT_TRIM=$((1 - OPT_TRIM)) ;;
		4) swap_available && OPT_HOME=$((1 - OPT_HOME)) ;; 5) OPT_REMOVE=$((1 - OPT_REMOVE)) ;;
		q | Q) say "Nothing was changed." && exit 0 ;;
		'') return 0 ;;
		esac
	done
}

opt_line() {
	local box=$G_OFF
	[ "$2" = 1 ] && box=$G_ON
	printf '   %s %s %s  %s%s%s\n' "$1" "$box" "$3" "$C_DIM" "$4" "$C_OFF"
}

# --- running (cleanup/CleanupRunner.kt): each step reads the TV, changes it, reads it back and logs the change ------

RUN_STOP=0
GUARD_PID=''

# Runs one step to the end even if Ctrl-C is pressed, like the app's NonCancellable steps: a background subshell
# ignores SIGINT (and so does everything it starts), while this shell's trap only asks the run to stop after it. The
# globals a step sets come back through a file. A second Ctrl-C quits at once (cleanup_on_exit stops the step).
GUARD_VARS="STEP_MSG VERIFIED_OFF VERIFIED_REMOVED SWAP_DONE CONFIRMED LOCK_HELD LOCKED_BY RECOVER RB_MSG RB_COMPLETE UNIT_DONE FRESH_IDS"
guarded() {
	local rc f=$TMPD/guarded.vars
	rm -f "$f"
	(
		"$@"
		rc=$?
		for v in $GUARD_VARS; do printf '%s=%q\n' "$v" "${!v}"; done >"$f"
		exit "$rc"
	) &
	GUARD_PID=$!
	wait "$GUARD_PID"
	rc=$?
	while [ "$rc" -gt 128 ] && kill -0 "$GUARD_PID" 2>/dev/null; do
		wait "$GUARD_PID"
		rc=$?
	done
	GUARD_PID=''
	# shellcheck disable=SC1090
	[ -f "$f" ] && . "$f"
	return "$rc"
}

# Step 0: take the lock, save the restore point (first one ever kept as "original"), put back an unfinished swap.
step_start() {
	local rc rp
	lock_acquire
	rc=$?
	case $rc in
	0) ;;
	3) STEP_MSG="Another phone ($LOCKED_BY) is cleaning this TV" && return 3 ;;
	4) STEP_MSG="This TV was set up with a newer version of ExBloat TV. Update exbloattv first." && return 3 ;;
	*) STEP_MSG="Couldn't update the record of changes on the TV. Try again" && return 1 ;;
	esac
	rp=$(restore_point_json)
	if [ "$DRY" = 1 ]; then
		EXB_ORIGINAL=$rp EXB_LATEST=$rp state_edit && state_save "$NEW_RAW" "save the restore point"
		return 0
	fi
	state_load || return 1
	EXB_LOCK=$(lock_json) EXB_ORIGINAL=$rp EXB_LATEST=$rp state_edit || return 1
	state_save "$NEW_RAW" "save the restore point" || {
		STEP_MSG="Couldn't update the record of changes on the TV. Try again"
		return 1
	}
	swap_recover 0
	[ "$RECOVER" = rolledback ] && STEP_MSG=$RB_MSG
	return 0
}

restore_point_json() {
	local a=() v
	for v in "${ANIM_RAW[@]}"; do a[${#a[@]}]=$(scale_value "$v"); done
	{
		printf '%s\n' "${A_PKG[@]}" | paste -d "$US" - <(printf '%s\n' "${A_EN[@]}") <(printf '%s\n' "${A_SYS[@]}") <(printf '%s\n' "${A_REM[@]}")
	} | awk -F"$US" -v at="$(now_ms)" -v by="$(json_str "$ME")" -v home="$TV_HOME" -v w="${a[0]}" -v t="${a[1]}" -v an="${a[2]}" -v bgf="$TMPD/inv/bgops" '
	function add(list, p) { return list (list == "" ? "" : ",") "\"" p "\"" }
	$4 == 1 { next }
	{ if ($2 == 1) en = add(en, $1); else dis = add(dis, $1); if ($3 == 0) usr = add(usr, $1) }
	END {
		while ((getline line < bgf) > 0) { split(line, kv, "\t"); bg = bg (bg == "" ? "" : ",") "\"" kv[1] "\":\"" kv[2] "\"" }
		printf "{\"takenAt\":%s,\"byPhone\":%s,\"enabled\":[%s],\"disabled\":[%s],\"userInstalled\":[%s],\"resolvedHome\":%s,", at, by, en, dis, usr, (home == "" ? "null" : "\"" home "\"")
		printf "\"animations\":{\"window\":%s,\"transition\":%s,\"animator\":%s},\"backgroundOps\":{%s}}", w, t, an, bg
	}'
}

# STEP_MSG explains a failure. Returns 0 done, 1 failed, 2 lost the TV, 3 stop everything (lock lost, newer app).
log_or_fail() { # map a log_write result
	case $1 in
	0) return 0 ;;
	3) STEP_MSG="Another phone ($LOCKED_BY) is cleaning this TV" && return 3 ;;
	4) STEP_MSG="This TV was set up with a newer version of ExBloat TV. Update exbloattv first." && return 3 ;;
	2) STEP_MSG="Lost connection to the TV" && return 2 ;;
	*) STEP_MSG="Couldn't update the record of changes on the TV. Try again" && return 1 ;;
	esac
}
read_fail() { STEP_MSG="Couldn't check the TV (${READ_FAILED:-app list}). Try again"; [ "$TV_RC" = 255 ] && return 2; return 1; }
new_id() { printf 'run-%s:%s:%s' "$RUN_STAMP" "$1" "$(rand_hex)"; }

step_disable() { # step_disable i disable|remove
	local i=$1 how=$2 pkg=${A_PKG[$1]} rc
	if [ "$DRY" = 1 ]; then
		if [ "$how" = remove ]; then tv_do "pm uninstall -k --user 0 $pkg"; else tv_do "pm disable-user --user 0 $pkg"; fi
		return 0
	fi
	protected_now "$pkg"
	case $? in 0) STEP_MSG="This app keeps the TV working, so it was left on" && return 1 ;; 2) read_fail && return $? ;; esac
	presence "$pkg" || { read_fail; return $?; }
	[ "$PRESENCE" = ENABLED ] || return 0 # already off
	if [ "$how" = disable ]; then
		log_begin "$(new_id "$i")" DISABLE "$pkg" enabled disabled
		log_or_fail $? || return $?
		tv_do "pm disable-user --user 0 $pkg"
		presence "$pkg" || { read_fail; return $?; }
		case $PRESENCE in
		DISABLED)
			log_confirm
			log_or_fail $? || return $?
			VERIFIED_OFF="$VERIFIED_OFF $pkg"
			return 0
			;;
		ABSENT)
			log_discard # switching off never removes an app: something else did
			return 0
			;;
		esac
		# Printed success but still on. Only for apps that came with the TV: remove it for the user instead.
		if [ "${A_SYS[i]}" != 1 ]; then
			log_discard
			STEP_MSG="Couldn't switch this app off"
			return 1
		fi
		log_rekind REMOVE_FOR_USER removed
		log_or_fail $? || return $?
	else
		log_begin "$(new_id "$i")" REMOVE_FOR_USER "$pkg" enabled removed
		log_or_fail $? || return $?
	fi
	tv_do "pm uninstall -k --user 0 $pkg"
	presence "$pkg" || { read_fail; return $?; }
	case $PRESENCE in
	DISABLED)
		log_confirm DISABLE disabled
		rc=$?
		VERIFIED_OFF="$VERIFIED_OFF $pkg"
		log_or_fail $rc
		return
		;;
	ABSENT)
		log_confirm
		rc=$?
		VERIFIED_REMOVED="$VERIFIED_REMOVED $pkg"
		log_or_fail $rc
		return
		;;
	esac
	log_discard
	STEP_MSG="Couldn't switch this app off"
	return 1
}

step_enable() {
	local i=$1 pkg=${A_PKG[$1]}
	[ "$DRY" = 1 ] && tv_do "pm enable $pkg" && return 0
	listed -e "$pkg"
	case $? in 0) return 0 ;; 1) ;; *) read_fail && return $? ;; esac
	listed -d "$pkg"
	case $? in 0) ;; 1) STEP_MSG="This app isn't on the TV any more" && return 1 ;; *) read_fail && return $? ;; esac
	log_begin "$(new_id "$i")" ENABLE "$pkg" disabled enabled
	log_or_fail $? || return $?
	tv_do "pm enable $pkg"
	listed -e "$pkg"
	case $? in
	0)
		log_confirm
		log_or_fail $?
		return
		;;
	1)
		log_discard
		STEP_MSG="Couldn't switch this app on"
		return 1
		;;
	*) read_fail && return $? ;;
	esac
}

step_install_existing() {
	local i=$1 pkg=${A_PKG[$1]}
	if [ "$DRY" = 1 ]; then
		tv_do "cmd package install-existing $pkg"
		return 0
	fi
	listed "" "$pkg"
	case $? in
	0) ;;
	1)
		log_begin "$(new_id "$i")" INSTALL_EXISTING "$pkg" removed installed
		log_or_fail $? || return $?
		tv_do "cmd package install-existing $pkg"
		listed "" "$pkg"
		case $? in
		0) log_confirm || { log_or_fail $?; return $?; } ;;
		1) log_discard && STEP_MSG="Couldn't bring this app back" && return 1 ;;
		*) read_fail && return $? ;;
		esac
		;;
	*) read_fail && return $? ;;
	esac
	# Back, but maybe switched off by an earlier half-done switch-off: switch it on too (its own logged change).
	step_enable "$i"
}

appop_of() { # APPOP = mode of op for pkg ("default" if not shown)
	tv_read "background setting" "cmd appops get $1 $2" || return 1
	APPOP=$(printf '%s\n' "$TV_OUT" | awk -v op="$2" '{ line = $0; sub(/^[ \t]*/, "", line); if (index(line, op ":") == 1) { line = substr(line, length(op) + 2); sub(/^[ \t]*/, "", line); if (match(line, /^[A-Za-z0-9_]+/)) { print substr(line, 1, RLENGTH); exit } } }')
	[ -n "$APPOP" ] || APPOP=default
}

step_background() { # RUN_IN_BACKGROUND, and on Android 9+ also RUN_ANY_IN_BACKGROUND, set to ignore; one change per op
	local i=$1 pkg=${A_PKG[$1]} op ops=RUN_IN_BACKGROUND from
	[ "$TV_SDK" -ge 28 ] && ops="RUN_IN_BACKGROUND RUN_ANY_IN_BACKGROUND"
	for op in $ops; do
		if [ "$DRY" = 1 ]; then
			tv_do "cmd appops set $pkg $op ignore"
			continue
		fi
		appop_of "$pkg" "$op" || { read_fail; return $?; }
		[ "$APPOP" = ignore ] && continue
		from=$APPOP
		log_begin "$(new_id "$i:$op")" APPOPS "$pkg" "$op=$from" "$op=ignore"
		log_or_fail $? || return $?
		tv_do "cmd appops set $pkg $op ignore"
		appop_of "$pkg" "$op" || { read_fail; return $?; }
		if [ "$APPOP" = ignore ]; then
			log_confirm || { log_or_fail $?; return $?; }
			continue
		fi
		[ "$APPOP" = "$from" ] && log_discard
		STEP_MSG="Couldn't stop this app running in the background"
		return 1
	done
	return 0
}

anim_now() { # ANIM_NOW = "w,t,a" raw values
	local k v=''
	for k in $ANIM_KEYS; do
		tv_read "animation settings" "settings get global $k" || return 1
		TV_OUT=$(printf '%s' "$TV_OUT" | tr -d ' \n')
		[ "$TV_OUT" = null ] || [[ $TV_OUT =~ ^-?[0-9]*\.?[0-9]+$ ]] || {
			READ_FAILED="animation settings"
			return 1
		}
		v="$v,$TV_OUT"
	done
	ANIM_NOW=${v#,}
}
anim_all_fast() {
	local IFS=, x
	for x in $1; do [ "$(scale_value "$x")" = "$FAST" ] || return 1; done
}

step_animations() {
	local k from
	if [ "$DRY" = 1 ]; then
		for k in $ANIM_KEYS; do tv_do "settings put global $k $FAST"; done
		return 0
	fi
	anim_now || { read_fail; return $?; }
	anim_all_fast "$ANIM_NOW" && return 0
	from=$ANIM_NOW
	log_begin "$(new_id anim)" ANIMATIONS "" "$from" "$FAST,$FAST,$FAST"
	log_or_fail $? || return $?
	for k in $ANIM_KEYS; do tv_do "settings put global $k $FAST"; done
	anim_now || { read_fail; return $?; }
	if anim_all_fast "$ANIM_NOW"; then
		log_confirm || { log_or_fail $?; return $?; }
		return 0
	fi
	[ "$ANIM_NOW" = "$from" ] && log_discard # a partial change stays logged so Undo puts it back
	STEP_MSG="Couldn't change the animation speed"
	return 1
}

step_trim() {
	tv_do "pm trim-caches 999G" 120
	[ "$TV_RC" = 255 ] && STEP_MSG="Lost connection to the TV" && return 2
	if [ "$TV_RC" = 0 ] && ! pm_error "$TV_OUT"; then return 0; fi
	STEP_MSG="Couldn't clear temporary files"
	return 1
}

# Connection lost mid-run: try again after 2, 5 and 10 seconds (CleanupRunner.BACKOFF_MS).
reconnect() {
	local d
	for d in 2 5 10; do
		sleep "$d"
		[ -n "$HOST" ] && adb_connect "$SERIAL"
		if [ "$(adb_state "$SERIAL")" = device ]; then
			tv_sh "echo ok" 15
			[ "$TV_RC" = 0 ] && return 0
		fi
	done
	return 1
}

run_step() { # run_step "kind i"
	local s=$1 kind=${1%% *} i=${1#* }
	STEP_MSG=''
	case $kind in
	start) step_start ;;
	disable) step_disable "$i" disable ;;
	remove) step_disable "$i" remove ;;
	enable) step_enable "$i" ;;
	install-existing) step_install_existing "$i" ;;
	background) step_background "$i" ;;
	animations) step_animations ;;
	trim) step_trim ;;
	swap) step_swap ;;
	reboot) step_reboot ;;
	*) STEP_MSG="Unknown step $s" && return 1 ;;
	esac
}

run_all() {
	local s rc text done_n=0 fail_n=0 skip_n=0 all
	RUN_STAMP="$(now_ms)-$(rand_hex)"
	CONFIRMED=0 VERIFIED_OFF='' VERIFIED_REMOVED='' SWAP_DONE=0
	all=("start" "${STEPS[@]}")
	if [ "$DRY" = 1 ]; then
		title "Dry run: nothing on the TV changes"
		note "These are the commands a real run would send, in order. Reads (pm list packages, settings get, …) run before"
		note "and after each change to check it; every change is also logged in $STATE_FILE (written as shown)."
	else
		title "Cleaning up $(tv_label)"
		note "Ctrl-C stops after the current step. Everything changed so far is recorded on the TV and can be undone."
	fi
	RUNNING=1
	for s in "${all[@]}"; do
		if [ "$RUN_STOP" = 1 ]; then
			skip_n=$((skip_n + 1))
			continue
		fi
		if [ "$s" = start ]; then text="Save a restore point"; else text=$(step_text "$s"); fi
		[ "$DRY" = 1 ] && printf '%s%s%s\n' "$C_BOLD" "$text" "$C_OFF"
		[ "$DRY" != 1 ] && [ -n "$CLR" ] && printf '  %s %s' "$G_RUN" "$text"
		while :; do
			guarded run_step "$s"
			rc=$?
			[ "$rc" = 2 ] && [ "$DRY" != 1 ] && {
				[ -n "$CLR" ] && printf '%s  %s %s %s(lost connection, reconnecting…)%s' "$CLR" "$G_RUN" "$text" "$C_DIM" "$C_OFF"
				if reconnect; then
					guarded swap_recover 0 # after every new connection, like the app
					continue
				fi
				STEP_MSG="Lost connection to the TV. Check it's on and on the same Wi-Fi, then run exbloattv again"
			}
			break
		done
		[ "$DRY" = 1 ] && continue
		if [ "$rc" = 0 ]; then
			done_n=$((done_n + 1))
			printf '%s  %s%s%s %s%s\n' "$CLR" "$C_ACC" "$G_OK" "$C_OFF" "$text" "${STEP_MSG:+  $C_DIM$STEP_MSG$C_OFF}"
		else
			fail_n=$((fail_n + 1))
			printf '%s  %s%s %s%s  %s\n' "$CLR" "$C_RED" "$G_FAIL" "$text" "$C_OFF" "$STEP_MSG"
			# Without the lock and restore point nothing may change; a lost lock or lost TV ends the run.
			if [ "$s" = start ] || [ "$rc" = 3 ] || [ "$rc" = 2 ]; then RUN_STOP=1; fi
		fi
	done
	RUNNING=0
	if [ "$DRY" = 1 ]; then
		lock_release
		printf '\n'
		good "Dry run finished. Nothing on the TV was changed."
		return 0
	fi
	lock_release >/dev/null 2>&1
	printf '\n'
	if [ "$fail_n" = 0 ] && [ "$skip_n" = 0 ]; then
		good "All clean. Your TV should feel noticeably faster."
	elif [ "$skip_n" -gt 0 ]; then
		warn "Cleanup stopped. The cleanup stopped before the end. Everything it changed is recorded on the TV, so you can run it again or undo it."
	else
		warn "Cleaned up, with a few skips. Run exbloattv again to retry what didn't work."
	fi
	note "Undo any time: exbloattv undo (or Undo everything in the ExBloat TV app)."
	[ "$fail_n" = 0 ] && [ "$skip_n" = 0 ]
}

# --- the new home screen (cleanup/LauncherSwap.kt) ------------------------------------------------------------------
# One swap's log entries share the id prefix swap-<ts>-<rand>: ":install" (INSTALL_APK) or ":enable:<FLauncher>"
# (ENABLE), ":disable:<pkg>" per stock launcher and the setup wizard, and ":home" (LAUNCHER_SWAP), written only once
# FLauncher is confirmed as the home screen. A swap without ":home" is unfinished and gets rolled back.

latest_swap() { # LAST_SWAP = id prefix of the newest logged swap ("" if none); LAST_DONE = 1 if it has a verified :home
	local j
	LAST_SWAP='' LAST_DONE=0
	for ((j = NCH - 1; j >= 0; j--)); do
		case ${CH_ID[j]} in swap-*:*)
			LAST_SWAP=${CH_ID[j]%%:*}
			break
			;;
		esac
	done
	[ -n "$LAST_SWAP" ] || return 0
	for ((j = 0; j < NCH; j++)); do [ "${CH_ID[j]}" = "$LAST_SWAP:home" ] && [ "${CH_VER[j]}" = true ] && LAST_DONE=1; done
	return 0
}

download_flauncher() { # APK = a file whose SHA-256 matches, or fail with STEP_MSG
	local target=$CACHE_DIR/$FLAUNCHER_SHA256.apk part
	mkdir -p "$CACHE_DIR" || {
		STEP_MSG="Couldn't create $CACHE_DIR"
		return 1
	}
	if [ -f "$target" ]; then
		[ "$(sha256_of "$target")" = "$FLAUNCHER_SHA256" ] && APK=$target && return 0
		rm -f "$target"
	fi
	command -v curl >/dev/null 2>&1 || {
		STEP_MSG="curl is needed to download the new home screen. Install curl, then run exbloattv again"
		return 1
	}
	part=$CACHE_DIR/download-$$.part
	if ! curl -fsSL --retry 2 --connect-timeout 20 -o "$part" "$FLAUNCHER_URL"; then
		rm -f "$part"
		STEP_MSG="Couldn't download the new home screen. Check this computer's internet connection"
		return 1
	fi
	if [ "$(sha256_of "$part")" != "$FLAUNCHER_SHA256" ]; then
		rm -f "$part"
		STEP_MSG="The new home screen download didn't match the expected file, so it wasn't used"
		return 1
	fi
	mv "$part" "$target" && APK=$target
}

# Whether FLauncher was first installed between 60 s before AT and 10 minutes after (both TV clock readings are local
# times, so their difference is laid onto this computer's clock and time zones cancel out).
installed_during() {
	local at=$1 first tvnow
	tv_read "app details" "dumpsys package $FLAUNCHER_PKG" || return 1
	first=$(printf '%s\n' "$TV_OUT" | sed -n 's/.*firstInstallTime=\([0-9-]* [0-9:]*\).*/\1/p' | head -n 1)
	tv_read "TV clock" "date '+%Y-%m-%d %H:%M:%S'" || return 1
	tvnow=$(printf '%s' "$TV_OUT" | head -n 1)
	[ -n "$first" ] && [ -n "$tvnow" ] || return 1
	awk -v a="$first" -v b="$tvnow" -v now="$(now_ms)" -v at="$at" '
	function secs(t,   d, p, y, m, dd, z) {
		split(t, p, /[- :]/); y = p[1]; m = p[2]; dd = p[3]
		if (m <= 2) { y--; m += 12 }
		d = 365 * y + int(y / 4) - int(y / 100) + int(y / 400) + int((153 * (m - 3) + 2) / 5) + dd
		return d * 86400 + p[4] * 3600 + p[5] * 60 + p[6]
	}
	BEGIN { inst = now - (secs(b) - secs(a)) * 1000; exit !(inst >= at - 60000 && inst <= at + 600000) }'
}

# Puts back everything the log says swap SID did (LauncherSwap.rollback). Best effort, every part tried.
# RB_COMPLETE=1 when the old home screen is confirmed back; RB_MSG says what happened.
swap_rollback() { # swap_rollback SID REASON
	local sid=$1 reason=$2 j disabled=() restored=() install_j=-1 enable_j=-1 real='' can_drop=0 undone=1 expected='' back=0 drop p
	state_read >/dev/null 2>&1
	for ((j = 0; j < NCH; j++)); do
		case ${CH_ID[j]} in "$sid":*) ;; *) continue ;; esac
		[ "${CH_KIND[j]}" = DISABLE ] && disabled[${#disabled[@]}]=${CH_PKG[j]}
		[ "${CH_ID[j]}" = "$sid:install" ] && install_j=$j
		[ "${CH_ID[j]}" = "$sid:enable:$FLAUNCHER_PKG" ] && enable_j=$j
	done
	for ((j = ${#disabled[@]} - 1; j >= 0; j--)); do
		p=${disabled[j]}
		is_pkg "$p" || continue # names from the shared log never go into a command unchecked
		tv_sh "pm enable $p" 30
		listed -e "$p" && restored[${#restored[@]}]=$p
	done
	if home_packages; then for p in $HOMES; do in_list "$p" "$NOT_A_REAL_HOME" || real="$real $p"; done; fi
	[ ${#restored[@]} = ${#disabled[@]} ] && [ -n "$real" ] && can_drop=1 # never take FLauncher away before a real home is back
	if [ "$install_j" -ge 0 ]; then
		undone=0
		if [ "$can_drop" = 1 ]; then
			listed "" "$FLAUNCHER_PKG"
			case $? in
			1) undone=1 ;;
			0)
				if [ "${CH_VER[install_j]}" != true ] && ! installed_during "${CH_AT[install_j]}"; then
					undone=1 # not ours: the person's own copy stays
				else
					tv_sh "pm uninstall $FLAUNCHER_PKG" 60
					listed "" "$FLAUNCHER_PKG"
					[ $? = 1 ] && undone=1
				fi
				;;
			esac
		fi
	elif [ "$enable_j" -ge 0 ]; then
		undone=0
		if [ "$can_drop" = 1 ]; then
			tv_sh "pm disable-user --user 0 $FLAUNCHER_PKG" 30
			listed -d "$FLAUNCHER_PKG" && undone=1
		fi
	fi
	tv_sh "$HOME_KEY" 15
	for p in "${restored[@]}"; do in_list "$p" "$NOT_A_REAL_HOME" || expected="$expected $p"; done
	[ -n "$expected" ] || expected=$real
	if [ ${#restored[@]} = ${#disabled[@]} ] && [ "$undone" = 1 ] && [ -n "$expected" ] && poll 15 fg_in "$expected"; then back=1; fi
	# Log last: a state-file failure must not stop the TV getting its home screen back.
	drop="$sid:home"
	for p in "${restored[@]}"; do drop="$drop $sid:disable:$p"; done
	if [ "$undone" = 1 ]; then
		[ "$install_j" -ge 0 ] && drop="$drop $sid:install"
		[ "$enable_j" -ge 0 ] && drop="$drop $sid:enable:$FLAUNCHER_PKG"
	fi
	# shellcheck disable=SC2086
	log_drop $drop >/dev/null 2>&1
	RB_COMPLETE=$back
	if [ "$back" = 1 ]; then
		RB_MSG="${reason:+$reason. }Your old home screen is back"
	else
		RB_MSG="${reason:+$reason. }Press Home on the remote; if the old home screen doesn't come back, use exbloattv undo"
	fi
}

# After a new connection: undo an unfinished swap; keep a finished one while HOME is still FLauncher.
# RECOVER = none | kept | rolledback. AFTER_RESTART=1 also presses HOME and checks FLauncher comes up.
swap_recover() {
	RECOVER=none
	[ "$DRY" = 1 ] && return 0
	state_read >/dev/null 2>&1 || return 0
	latest_swap
	[ -n "$LAST_SWAP" ] || return 0
	if [ "$LAST_DONE" = 0 ]; then
		swap_rollback "$LAST_SWAP" "The connection to the TV was lost while setting up the new home screen"
		RECOVER=rolledback
	elif [ "$1" = 1 ]; then
		tv_sh "$HOME_KEY" 15
		if poll 15 home_is_flauncher; then RECOVER=kept; else
			swap_rollback "$LAST_SWAP" "The new home screen didn't come back after the restart"
			RECOVER=rolledback
		fi
	elif resolved_home && [ "$HOME_PKG" = "$FLAUNCHER_PKG" ]; then
		RECOVER=kept
	else
		swap_rollback "$LAST_SWAP" "The TV wasn't showing the new home screen"
		RECOVER=rolledback
	fi
}

step_swap() {
	local sid home_before stock='' wizard='' p failure='' rc homes
	if [ "$(lower "$TV_MANUFACTURER")" = amazon ]; then
		STEP_MSG="Fire TV not supported yet"
		return 1
	fi
	if [ "$DRY" = 1 ]; then
		if ! grep -qxF "$FLAUNCHER_PKG" "$TMPD/inv/all.list"; then
			printf '  %scurl -fsSL -o %s/%s.apk %s   # then check SHA-256%s\n' "$C_DIM" "$CACHE_DIR" "$FLAUNCHER_SHA256" "$FLAUNCHER_URL" "$C_OFF"
			printf '  %sadb -s %s install %s/%s.apk%s\n' "$C_DIM" "$SERIAL" "$CACHE_DIR" "$FLAUNCHER_SHA256" "$C_OFF"
		fi
		tv_do "monkey -p $FLAUNCHER_PKG -c android.intent.category.LAUNCHER 1"
		while read -r p; do
			[ "$p" = "$FLAUNCHER_PKG" ] || [ "$p" = "$TV_SETTINGS" ] || safety_protected "$p" || tv_do "pm disable-user --user 0 $p"
		done <"$TMPD/inv/home.list"
		grep -qxF "$SETUPWRAITH" "$TMPD/inv/home.list" || ! grep -qxF "$SETUPWRAITH" "$TMPD/inv/all.list" || grep -qxF "$SETUPWRAITH" "$TMPD/inv/dis.list" || tv_do "pm disable-user --user 0 $SETUPWRAITH"
		tv_do "$HOME_KEY"
		return 0
	fi
	state_read || { read_fail; return $?; }
	latest_swap
	if [ -n "$LAST_SWAP" ] && [ "$LAST_DONE" = 0 ]; then
		swap_rollback "$LAST_SWAP" "The connection to the TV was lost while setting up the new home screen"
		[ "$RB_COMPLETE" = 1 ] || {
			STEP_MSG=$RB_MSG
			return 1
		}
	fi
	resolved_home || { read_fail; return $?; }
	home_before=$HOME_PKG
	if [ "$home_before" = "$FLAUNCHER_PKG" ]; then
		foreground
		if { [ "$LAST_DONE" = 1 ] || [ "$FG" = "$FLAUNCHER_PKG" ]; } && ! listed -e "$SETUPWRAITH"; then
			SWAP_DONE=1
			return 0
		fi
	fi
	sid="swap-$(now_ms)-$(rand_hex)"
	# Make sure FLauncher is installed and on, logging ahead of each change.
	listed "" "$FLAUNCHER_PKG"
	rc=$?
	if [ "$rc" = 1 ]; then
		download_flauncher || return 1
		log_begin "$sid:install" INSTALL_APK "$FLAUNCHER_PKG" "not installed" "$FLAUNCHER_VERSION"
		log_or_fail $? || return $?
		with_timeout 300 "$ADB" -s "$SERIAL" install "$APK" </dev/null >"$TMPD/install.out" 2>&1
		rc=$?
		if [ "$rc" = 0 ] && listed "" "$FLAUNCHER_PKG"; then
			log_confirm || { log_or_fail $?; return $?; }
		else
			failure="Couldn't install the new home screen"
		fi
	elif [ "$rc" = 0 ]; then
		if listed -d "$FLAUNCHER_PKG"; then
			log_begin "$sid:enable:$FLAUNCHER_PKG" ENABLE "$FLAUNCHER_PKG" disabled enabled
			log_or_fail $? || return $?
			tv_sh "pm enable $FLAUNCHER_PKG" 30
			if listed -e "$FLAUNCHER_PKG"; then log_confirm || { log_or_fail $?; return $?; }; else failure="Couldn't switch on the new home screen"; fi
		fi
	else
		read_fail
		return $?
	fi
	# Open FLauncher, switch off the stock home screen(s) and the setup wizard, confirm HOME.
	if [ -z "$failure" ]; then
		tv_sh "monkey -p $FLAUNCHER_PKG -c android.intent.category.LAUNCHER 1" 30
		if ! poll 15 fg_in "$FLAUNCHER_PKG"; then
			tv_sh "am start -n $FLAUNCHER_PKG/.MainActivity" 30
			poll 15 fg_in "$FLAUNCHER_PKG" || failure="The new home screen didn't open"
		fi
	fi
	if [ -z "$failure" ]; then
		if home_packages && [ -n "$HOMES" ]; then
			homes=$HOMES
			for p in $homes; do
				[ "$p" = "$FLAUNCHER_PKG" ] || [ "$p" = "$TV_SETTINGS" ] || safety_protected "$p" || stock="$stock $p"
			done
			if ! in_list "$SETUPWRAITH" "$stock" && listed -e "$SETUPWRAITH" && ! safety_protected "$SETUPWRAITH"; then wizard=$SETUPWRAITH; fi
			for p in $stock $wizard; do
				log_begin "$sid:disable:$p" DISABLE "$p" enabled disabled
				log_or_fail $? || return $?
				tv_sh "pm disable-user --user 0 $p" 30
				if listed -d "$p"; then log_confirm || { log_or_fail $?; return $?; }; else
					failure="Couldn't switch off the old home screen"
					break
				fi
			done
		else
			failure="Couldn't read the TV's home screens"
		fi
	fi
	if [ -z "$failure" ]; then
		tv_sh "$HOME_KEY" 15
		if poll 15 home_is_flauncher; then
			stock=$(printf '%s' "$stock" | sed 's/^ //; s/ /,/g')
			EXB_UPSERT=$(change_json "$sid:home" LAUNCHER_SWAP "$FLAUNCHER_PKG" "$stock" "$FLAUNCHER_PKG" true "$(now_ms)") log_write "log the finished home screen swap"
			log_or_fail $? || return $?
			SWAP_DONE=1
			return 0
		fi
		failure="The TV didn't switch to the new home screen"
	fi
	swap_rollback "$sid" "$failure"
	STEP_MSG=$RB_MSG
	return 1
}

# --- restart and verify (CleanupRunner.rebootAndVerify): boot_id proves the restart really happened -----------------
# The restart goes through Android (`svc power reboot`), which first saves settings it hasn't written yet. Android
# saves switched-off apps about 10 s after the change, and a bare `adb reboot` skips that save, so apps switched off
# just before it come back on. `adb reboot` is only the fallback for a TV where svc can't restart.

step_reboot() {
	local before after start booted p back='' problems='' fallback=0
	if [ "$DRY" = 1 ]; then
		tv_do "svc power reboot exbloattv"
		printf '  %sadb -s %s reboot   # only if the TV is still up 30 s later%s\n' "$C_DIM" "$SERIAL" "$C_OFF"
		return 0
	fi
	tv_read "restart check" "cat /proc/sys/kernel/random/boot_id" || { read_fail; return $?; }
	before=$(printf '%s' "$TV_OUT" | tr -d ' \n')
	[ -n "$before" ] || { STEP_MSG="Couldn't check the TV (restart check). Try again" && return 1; }
	[ "$RUN_STOP" = 1 ] && STEP_MSG="Stopped before restarting" && return 1 # never restart a TV the person just stopped
	tv_sh "svc power reboot exbloattv" 15
	start=$(date +%s)
	while [ $(($(date +%s) - start)) -lt 180 ]; do
		sleep 5
		[ -n "$HOST" ] && adb_connect "$SERIAL" >/dev/null 2>&1
		tv_sh "getprop sys.boot_completed; cat /proc/sys/kernel/random/boot_id" 10
		[ "$TV_RC" = 0 ] || continue
		booted=$(printf '%s\n' "$TV_OUT" | sed -n 1p | tr -d ' ')
		after=$(printf '%s\n' "$TV_OUT" | sed -n 2p | tr -d ' ')
		[ "$booted" = 1 ] && [ -n "$after" ] && [ "$after" != "$before" ] && break
		if [ "$after" = "$before" ] && [ "$fallback" = 0 ] && [ $(($(date +%s) - start)) -ge 30 ]; then
			fallback=1 # still up on the same boot: this TV's svc can't restart it
			with_timeout 15 "$ADB" -s "$SERIAL" reboot </dev/null >/dev/null 2>&1
		fi
		after=''
	done
	if [ -z "$after" ]; then
		STEP_MSG="The TV didn't come back after restarting. Check it's on, then run exbloattv again"
		return 2
	fi
	if [ "$SWAP_DONE" = 1 ]; then swap_recover 1; else swap_recover 0; fi
	[ "$RECOVER" = rolledback ] && problems=$RB_MSG
	tv_read "switched-off app list" "pm list packages -d" pm || { read_fail; return $?; }
	for p in $VERIFIED_OFF; do printf '%s\n' "$TV_OUT" | grep -qxF "package:$p" || back="$back, $(app_name "$p")"; done
	if [ -n "$VERIFIED_REMOVED" ]; then
		tv_read "app list" "pm list packages" pm || { read_fail; return $?; }
		for p in $VERIFIED_REMOVED; do printf '%s\n' "$TV_OUT" | grep -qxF "package:$p" && back="$back, $(app_name "$p")"; done
	fi
	[ -n "$back" ] && problems="${problems:+$problems. }These apps switched themselves back on: ${back#, }"
	[ -z "$problems" ] && return 0
	STEP_MSG=$problems
	return 1
}

app_name() {
	local i
	for ((i = 0; i < N; i++)); do [ "${A_PKG[i]}" = "$1" ] && printf '%s' "${A_NAME[i]}" && return; done
	local l=${1##*.}
	[ -n "$l" ] || l=$1
	l=${l//_/ }
	printf '%s%s' "$(printf '%s' "${l:0:1}" | tr '[:lower:]' '[:upper:]')" "${l:1}"
}

# --- undo (cleanup/Undo.kt): reverse the shared change log, newest first, whoever made each change -----------------
# Each reversal is checked on the TV before its entry is dropped (one write per entry, so an interrupted undo resumes
# cleanly). Once something couldn't be put back, older changes to the same thing wait. A launcher swap is undone as
# one unit. Deleted apps can only come back from the Play Store.

change_keys() { # keys of change j: what it is about
	case ${CH_KIND[$1]} in
	ANIMATIONS) printf 'animations' ;;
	APPOPS)
		local op=RUN_ANY_IN_BACKGROUND
		case ${CH_FROM[$1]} in *=*) op=${CH_FROM[$1]%%=*} ;; esac
		printf 'appops:%s:%s' "${CH_PKG[$1]}" "$op"
		;;
	*) printf 'app:%s' "${CH_PKG[$1]}" ;;
	esac
}

may_remove() { # switching off / removing during undo: never something vital, never the home screen in use
	safety_protected "$1" && return 1
	resolved_home || return 1
	[ "$1" != "$HOME_PKG" ]
}

restore_appop() { # restore_appop pkg from
	local op=RUN_ANY_IN_BACKGROUND mode=$2 want now
	case $2 in *=*) op=${2%%=*} mode=${2#*=} ;; esac
	in_list "$op" "RUN_ANY_IN_BACKGROUND RUN_IN_BACKGROUND" && in_list "$mode" "allow ignore deny default foreground" || return 1
	tv_do "cmd appops set $1 $op $mode"
	[ "$DRY" = 1 ] && return 0
	appop_of "$1" "$op" || return 1
	want=$mode now=$APPOP
	[ "$want" = default ] && want=allow
	[ "$now" = default ] && now=allow
	[ "$now" = "$want" ]
}

restore_animations() { # from = "w,t,a", "null" = never set (deleted again)
	local from=$1 k v vals=() i=0 now
	local IFS=,
	read -r -a vals <<<"$from"
	unset IFS
	[ ${#vals[@]} = 3 ] || return 1
	for v in "${vals[@]}"; do [ "$v" = null ] || [[ $v =~ $SCALE_RE ]] || return 1; done
	for k in $ANIM_KEYS; do
		if [ "${vals[i]}" = null ]; then tv_do "settings delete global $k"; else tv_do "settings put global $k ${vals[i]}"; fi
		i=$((i + 1))
	done
	[ "$DRY" = 1 ] && return 0
	i=0
	for k in $ANIM_KEYS; do
		tv_read "animation settings" "settings get global $k" || return 1
		now=$(printf '%s' "$TV_OUT" | tr -d ' \n')
		if [ "${vals[i]}" = null ]; then [ "$now" = null ] || return 1; else
			awk -v a="$now" -v b="${vals[i]}" 'BEGIN {exit !(a + 0 == b + 0 && a != "null")}' || return 1
		fi
		i=$((i + 1))
	done
}

# Reverses change j on the TV and checks it. 0 = put back, 1 = failed, 5 = deleted app missing (Play Store).
reverse_change() {
	local j=$1 pkg=${CH_PKG[$1]}
	case ${CH_KIND[j]} in ANIMATIONS) ;; *) is_pkg "$pkg" || return 1 ;; esac
	case ${CH_KIND[j]} in
	DISABLE)
		tv_do "pm enable $pkg"
		[ "$DRY" = 1 ] || listed -e "$pkg"
		;;
	REMOVE_FOR_USER)
		tv_do "cmd package install-existing $pkg"
		[ "$DRY" = 1 ] && return 0
		listed -d "$pkg" && tv_do "pm enable $pkg" # it was on when it was removed
		listed -e "$pkg"
		;;
	ENABLE)
		may_remove "$pkg" || return 1
		tv_do "pm disable-user --user 0 $pkg"
		[ "$DRY" = 1 ] || listed -d "$pkg"
		;;
	INSTALL_EXISTING)
		may_remove "$pkg" || return 1
		tv_do "pm uninstall -k --user 0 $pkg"
		[ "$DRY" = 1 ] && return 0
		listed "" "$pkg"
		[ $? = 1 ]
		;;
	ANIMATIONS) restore_animations "${CH_FROM[j]}" ;;
	APPOPS) restore_appop "$pkg" "${CH_FROM[j]}" ;;
	UNINSTALL)
		[ "$DRY" = 1 ] && return 5
		listed -e "$pkg" && return 0
		listed "" "$pkg" && return 1 # reinstalled but switched off: not as it was
		return 5
		;;
	*) return 1 ;; # FLauncher and HOME belong to a swap and are undone with it
	esac
}

undo_text() { # plain words for change j
	local n
	n=$(app_name "${CH_PKG[$1]}")
	case ${CH_KIND[$1]} in
	DISABLE) printf 'Switch %s back on' "$n" ;;
	REMOVE_FOR_USER) printf 'Bring back %s' "$n" ;;
	ENABLE) printf 'Switch %s off again' "$n" ;;
	INSTALL_EXISTING) printf 'Remove %s for the TV'"'"'s user again' "$n" ;;
	ANIMATIONS) printf 'Put the animation speed back' ;;
	APPOPS) printf 'Let %s run in the background again' "$n" ;;
	UNINSTALL) printf 'Check %s was reinstalled' "$n" ;;
	*) printf '%s %s' "${CH_KIND[$1]}" "$n" ;;
	esac
}

# One undo unit (a change, or a whole home screen swap), run guarded. Prints its line. UNIT_DONE = changes put back;
# FRESH_IDS = the log's ids afterwards. Returns 0 put back, 1 failed (STEP_MSG says what), 5 deleted app missing
# (only the Play Store can bring it back), 6 a swap that must wait for a newer one.
undo_unit() {
	local u=$1 id=${1#?:} j text sid onTv=0 left=0 rc
	UNIT_DONE=0 STEP_MSG=''
	if [ "${u%%:*}" = C ]; then
		j=$(change_index "$id")
		[ "$j" -ge 0 ] || return 0
		text=$(undo_text "$j")
		[ "$DRY" = 1 ] && printf '%s%s%s\n' "$C_BOLD" "$text" "$C_OFF"
		reverse_change "$j"
		rc=$?
		if [ "$DRY" = 1 ]; then
			[ "$rc" = 5 ] && note "  (only the Play Store can bring this app back)"
			return 0
		fi
		case $rc in
		0)
			if log_drop "$id" >/dev/null 2>&1; then
				UNIT_DONE=1
				printf '  %s%s%s %s\n' "$C_ACC" "$G_OK" "$C_OFF" "$text"
			else
				STEP_MSG="$text (record not updated)"
				rc=1
			fi
			;;
		5) STEP_MSG=${CH_PKG[j]} ;;
		*)
			STEP_MSG=$text
			rc=1
			printf '  %s%s %s%s\n' "$C_RED" "$G_FAIL" "$text" "$C_OFF"
			;;
		esac
	else
		sid=$id
		if [ "$DRY" = 1 ]; then
			printf '%sPut the old home screen back%s\n' "$C_BOLD" "$C_OFF"
			for ((j = NCH - 1; j >= 0; j--)); do
				case ${CH_ID[j]} in "$sid:disable:"*) tv_do "pm enable ${CH_PKG[j]}" ;; esac
			done
			for ((j = 0; j < NCH; j++)); do
				[ "${CH_ID[j]}" = "$sid:install" ] && tv_do "pm uninstall $FLAUNCHER_PKG   # only once a real home screen is back"
				[ "${CH_ID[j]}" = "$sid:enable:$FLAUNCHER_PKG" ] && tv_do "pm disable-user --user 0 $FLAUNCHER_PKG"
			done
			tv_do "$HOME_KEY"
			return 0
		fi
		for ((j = 0; j < NCH; j++)); do
			case ${CH_ID[j]} in "$sid":*) [ "${CH_ID[j]}" = "$sid:home" ] || onTv=$((onTv + 1)) ;; esac
		done
		latest_swap
		rc=0
		if [ "$onTv" = 0 ]; then
			log_drop "$sid:home" >/dev/null 2>&1 # only its record was left
		elif [ "$LAST_SWAP" != "$sid" ]; then
			STEP_MSG="an older home screen change (a newer one must be undone first)"
			rc=6
		else
			# Without ":home" the swap counts as unfinished: if undo stops here, the next run still puts it back.
			log_drop "$sid:home" >/dev/null 2>&1
			swap_rollback "$sid" ""
			state_read >/dev/null 2>&1
			for ((j = 0; j < NCH; j++)); do case ${CH_ID[j]} in "$sid":*) left=$((left + 1)) ;; esac; done
			UNIT_DONE=$((onTv - (left > onTv ? onTv : left)))
			if [ "$RB_COMPLETE" = 1 ] && [ "$left" = 0 ]; then
				printf '  %s%s%s Put the old home screen back\n' "$C_ACC" "$G_OK" "$C_OFF"
			else
				STEP_MSG="the home screen ($RB_MSG)"
				printf '  %s%s Put the old home screen back%s  %s\n' "$C_RED" "$G_FAIL" "$C_OFF" "$RB_MSG"
				rc=1
				[ "$left" -gt 0 ] || rc=7 # nothing left to retry: report, don't hold older changes back
			fi
		fi
	fi
	state_read >/dev/null 2>&1 && FRESH_IDS=$(printf '%s ' "${CH_ID[@]}")
	return "$rc"
}

# Re-takes the lock before each unit (as the app does) and notes the log's ids. Run guarded.
undo_refresh() {
	lock_acquire || return $?
	FRESH_IDS=$(printf '%s ' "${CH_ID[@]}")
}

undo_all() {
	local rc j u id keys waiting tried=' ' expected='' units n put_back=0 failed='' reinstall='' sid replan seen
	title "Undo everything"
	lock_acquire
	rc=$?
	case $rc in
	0) ;;
	3) die "Another phone ($LOCKED_BY) is changing this TV right now. Try again when it's done." ;;
	4) die "This TV was set up with a newer version of ExBloat TV. Update exbloattv first." ;;
	2) die "Can't reach the TV. Make sure it's on and on the same Wi-Fi." ;;
	*) die "Couldn't read the record of changes on the TV. Try again." ;;
	esac
	if [ "$NCH" = 0 ]; then
		lock_release >/dev/null 2>&1
		good "Nothing to undo: there are no recorded changes on this TV."
		return 0
	fi
	say "This puts the TV back the way it was before ExBloat TV changed it: apps switched back on, animations and the old home screen restored. Apps that were deleted can only come back from the Play Store."
	note "$NCH recorded $(plural "$NCH" change changes) on $(tv_label)."
	if [ "$YES" != 1 ]; then
		ask "Type yes to undo everything: " no
		case $REPLY in y | Y | yes | YES) ;; *)
			lock_release >/dev/null 2>&1
			say "Kept your changes."
			return 0
			;;
		esac
	fi
	if [ "$DRY" = 1 ]; then
		title "Dry run: nothing on the TV changes"
		note "Commands a real undo would send, newest change first:"
	else
		note "Ctrl-C stops after the current change. What's left stays on the list."
	fi
	RUNNING=1
	while :; do
		# Plan: newest first; a swap's entries form one unit at the position of its newest entry.
		units=()
		seen=' '
		for ((j = NCH - 1; j >= 0; j--)); do
			case ${CH_ID[j]} in
			swap-*:*)
				sid=${CH_ID[j]%%:*}
				in_list "$sid" "$seen" && continue
				seen="$seen$sid "
				units[${#units[@]}]="S:$sid"
				;;
			*) units[${#units[@]}]="C:${CH_ID[j]}" ;;
			esac
		done
		expected=$(printf '%s ' "${CH_ID[@]}")
		waiting=' '
		replan=0
		for u in "${units[@]}"; do
			[ "$RUN_STOP" = 1 ] && break
			id=${u#?:}
			keys=$(unit_keys "$u")
			# Tried already, or something newer about the same thing couldn't be put back: this one waits.
			if in_list "$id" "$tried" || keys_waiting "$keys" "$waiting"; then
				waiting="$waiting$keys "
				continue
			fi
			if [ "$DRY" != 1 ]; then
				guarded undo_refresh
				rc=$?
				if [ "$rc" != 0 ]; then
					RUN_STOP=1
					if [ "$rc" = 3 ]; then failed="$failed${failed:+; }another phone ($LOCKED_BY) took over this TV"; else failed="$failed${failed:+; }the TV stopped answering"; fi
					break
				fi
				if [ "$FRESH_IDS" != "$expected" ]; then
					replan=1 # another phone changed the log while this one was away: plan again from the fresh log
					state_read >/dev/null 2>&1
					break
				fi
			fi
			tried="$tried$id "
			if [ "$DRY" = 1 ]; then
				undo_unit "$u"
				continue
			fi
			guarded undo_unit "$u"
			rc=$?
			put_back=$((put_back + UNIT_DONE))
			case $rc in
			0) ;;
			5)
				reinstall="$reinstall $STEP_MSG"
				waiting="$waiting$keys "
				;;
			7) failed="$failed${failed:+; }$STEP_MSG" ;;
			*)
				failed="$failed${failed:+; }$STEP_MSG"
				waiting="$waiting$keys "
				;;
			esac
			expected=$FRESH_IDS
		done
		[ "$replan" = 1 ] || break
	done
	RUNNING=0
	lock_release >/dev/null 2>&1
	printf '\n'
	if [ "$DRY" = 1 ]; then
		good "Dry run finished. Nothing on the TV was changed."
		return 0
	fi
	n=$put_back
	if [ "$RUN_STOP" = 1 ] && [ -z "$failed" ]; then
		warn "Undo stopped before the end. What's left stays on the list, so run exbloattv undo again."
		return 1
	fi
	[ -z "$failed" ] && [ -z "$reinstall" ] && good "Undone: $n $(plural "$n" change changes) put back. The TV is back the way it was."
	[ -n "$failed" ] && warn "Couldn't undo everything: $failed. What's left stays on the list, so run exbloattv undo again."
	if [ -n "$reinstall" ]; then
		warn "Deleted apps can only come back from the Play Store on the TV:"
		for j in $reinstall; do say "  $(app_name "$j")  ($j)"; done
		note "To open one on the TV: adb -s $SERIAL shell am start -a android.intent.action.VIEW -d 'market://details?id=<package>' -p $PLAY_STORE"
	fi
	[ -z "$failed" ]
}

change_index() {
	local j
	for ((j = 0; j < NCH; j++)); do [ "${CH_ID[j]}" = "$1" ] && echo "$j" && return; done
	echo -1
}
unit_keys() {
	local j k=''
	if [ "${1%%:*}" = C ]; then
		j=$(change_index "${1#C:}")
		change_keys "$j"
		return
	fi
	for ((j = 0; j < NCH; j++)); do case ${CH_ID[j]} in "${1#S:}":*) k="$k $(change_keys "$j")" ;; esac; done
	printf '%s' "${k# }"
}
keys_waiting() {
	local k
	for k in $1; do in_list "$k" "$2" && return 0; done
	return 1
}

# --- commands ------------------------------------------------------------------------------------------------------

remember_tv() { [ -n "$HOST" ] && conf_put last-tv "host=$HOST" "serial=$TV_SERIAL" "name=${TV_MODEL:-Android TV}"; }

start_session() { # connect, read the TV
	connect_tv
	title "Reading your TV"
	note "Looking at every app on the TV. This takes a few seconds."
	read_inventory
	remember_tv
	good "$(tv_label) $G_DOT $N apps"
}

# Read-only look at the state file: refuse early if a newer app or a fresh lock rules out changes.
check_state_before_changes() {
	state_read
	case $? in 0) ;; 2) die "Can't reach the TV. Make sure it's on and on the same Wi-Fi." ;; *) die "Couldn't read the record of changes on the TV. Try again." ;; esac
	[ "$ST_STATUS" = toonew ] && die "This TV was set up with a newer version of ExBloat TV. Update exbloattv first."
	if lock_fresh_other; then
		if [ "$DRY" = 1 ]; then
			warn "Another phone ($ST_LOCK_BY) is cleaning this TV right now. A real run would stop here."
		else
			die "Another phone ($ST_LOCK_BY) is cleaning this TV. Nothing was changed. Try again when it's done (a lock expires after 10 minutes)."
		fi
	fi
}

cmd_clean() {
	start_session
	check_state_before_changes
	if [ "$YES" != 1 ]; then
		if [ "$PLAIN" != 1 ] && [ -t 0 ] && [ -t 1 ]; then tui_choose; else plain_choose; fi
	fi
	review
	[ ${#STEPS[@]} = 0 ] && return 0
	if [ "$YES" != 1 ] && [ "$DRY" != 1 ]; then
		ask "Clean up the TV now? Type yes to start: " no
		case $REPLY in y | Y | yes | YES) ;; *)
			say "Nothing was changed."
			return 0
			;;
		esac
	fi
	run_all
}

cmd_list() {
	local cat i st groups="$KEEP_GROUPS ADS_TRACKING" hidden=0
	start_session
	[ "$ALL" = 1 ] && groups="$groups LAUNCHER SYSTEM"
	for cat in $groups; do
		local any=0
		for ((i = 0; i < N; i++)); do
			[ "${A_CAT[i]}" = "$cat" ] || continue
			[ "$any" = 0 ] && printf '\n%s%s%s\n' "$C_BOLD" "$(cat_label "$cat")" "$C_OFF" && any=1
			if [ "${A_REM[i]}" = 1 ]; then st="${C_YEL}removed$C_OFF"; elif [ "${A_EN[i]}" = 1 ]; then st="${C_ACC}on$C_OFF     "; else st="${C_DIM}off$C_OFF    "; fi
			printf '  %s  %-30s %s%s%s\n' "$st" "$(fit "${A_NAME[i]}" 30)" "$C_DIM" "${A_PKG[i]}" "$C_OFF"
		done
	done
	for ((i = 0; i < N; i++)); do in_list "${A_CAT[i]}" "$groups" || hidden=$((hidden + 1)); done
	[ "$hidden" -gt 0 ] && note "
$hidden system apps and home screens not shown: the TV needs them, so they're never changed. Show them with --all."
	return 0
}

cmd_status() {
	local j by
	connect_tv
	read_inventory
	remember_tv
	title "$(tv_label)"
	say "  Serial         $TV_SERIAL"
	say "  Apps           $N ($(grep -c . "$TMPD/inv/dis.list" | tr -d ' ') switched off, $(grep -c . "$TMPD/inv/removed.list" | tr -d ' ') removed for the user)"
	say "  Home screen    ${TV_HOME:-none}"
	say "  Animations     ${ANIM_RAW[*]}"
	state_read || die "Couldn't read the record of changes on the TV."
	case $ST_STATUS in
	toonew) say "  Record         written by a newer ExBloat TV (left untouched)" ;;
	notours | othertv) say "  Record         not usable (would be set aside and started fresh)" ;;
	*)
		if [ "$ST_EXISTS" = 0 ]; then say "  Record         none yet (nothing changed by ExBloat TV)"; else
			say "  Record         $NCH recorded $(plural "$NCH" change changes) (undo with: exbloattv undo)"
			by=$(for ((j = 0; j < NCH; j++)); do printf '%s\n' "${CH_BY[j]}"; done | sort | uniq -c | awk '{c = $1; $1 = ""; printf "%s%s ×%s", (NR > 1 ? ", " : ""), substr($0, 2), c}')
			[ -n "$by" ] && say "                 by $by"
		fi
		if [ -n "$ST_LOCK_BY" ]; then
			if lock_fresh_other; then say "  Lock           held by $ST_LOCK_BY (cleaning now)"; else say "  Lock           stale, from $ST_LOCK_BY (ignored)"; fi
		else
			say "  Lock           free"
		fi
		;;
	esac
}

cmd_undo() {
	connect_tv
	note "Reading your TV…"
	read_inventory
	undo_all
}

usage() {
	cat <<EOF
exbloattv $VERSION: debloat an Android TV / Google TV box from this computer, over ADB.

Usage:
  exbloattv [options]          find the TV, choose what to keep, review, clean up
  exbloattv scan               look for TVs on this network (doesn't connect to any)
  exbloattv list               show the TV's apps, grouped like the app shows them
  exbloattv status             the TV, its home screen and the record of changes on it
  exbloattv undo               put back every recorded change (also ones the phone app made)

Options:
  --host IP[:PORT]   the TV's address (port 5555 unless given)
  --serial SERIAL    an adb serial instead (e.g. emulator-5554 for testing)
  --subnet A.B.C     scan A.B.C.1-254 instead of this computer's network
  --dry-run          print every command that would change the TV instead of running it
  --yes              with --dry-run only: take the default choices without asking
  --plain            numbered lists instead of the full-screen checklist
  --all              list: include system apps and home screens
  -h, --help         this help
  --version          print the version

Checklist keys: up/down or j/k move, space switches, a switches the whole group, enter reviews, q quits.
Changes are recorded on the TV in $STATE_FILE, shared with the ExBloat TV phone app.
Respects NO_COLOR. More: docs/cli.md, https://github.com/XploreDatum/exbloattv
EOF
}

cleanup_on_exit() {
	tui_restore
	if [ -n "$GUARD_PID" ]; then # quit mid-step: stop it; its write-ahead log entry says what may have happened
		pkill -TERM -P "$GUARD_PID" 2>/dev/null
		kill "$GUARD_PID" 2>/dev/null
	fi
	if [ "$LOCK_HELD" = 1 ] && [ "$DRY" != 1 ]; then
		lock_release >/dev/null 2>&1
	fi
	[ -n "$TMPD" ] && rm -rf "$TMPD"
}

on_int() {
	if [ "$RUNNING" = 1 ] && [ "$RUN_STOP" = 0 ]; then
		RUN_STOP=1
		printf '\n%sStopping after the current step… (Ctrl-C again to quit now)%s\n' "$C_YEL" "$C_OFF" >&2
		return
	fi
	exit 130
}

main() {
	local cmd=clean
	DRY=0 YES=0 PLAIN=0 ALL=0 HOST='' HOST_ARG='' SERIAL='' SERIAL_ARG='' SUBNET='' TMPD='' LOCK_HELD=0 TUI_ON=0 RUNNING=0 STTY_SAVED=''
	OPT_ANIM=1 OPT_BG=1 OPT_TRIM=1 OPT_HOME=1 OPT_REMOVE=0
	setup_style
	while [ $# -gt 0 ]; do
		case $1 in
		scan | list | status | undo) cmd=$1 ;;
		--host) HOST_ARG=${2:-} && shift ;;
		--host=*) HOST_ARG=${1#*=} ;;
		--serial | -s) SERIAL_ARG=${2:-} && shift ;;
		--serial=*) SERIAL_ARG=${1#*=} ;;
		--subnet) SUBNET=${2:-} && shift ;;
		--subnet=*) SUBNET=${1#*=} ;;
		--dry-run | -n) DRY=1 ;;
		--yes | -y) YES=1 ;;
		--plain) PLAIN=1 ;;
		--all) ALL=1 ;;
		-h | --help | help)
			usage
			exit 0
			;;
		--version | -V)
			echo "exbloattv $VERSION"
			exit 0
			;;
		*) die "Unknown option: $1 (see exbloattv --help)" ;;
		esac
		shift
	done
	[ "$YES" = 1 ] && [ "$DRY" != 1 ] && die "--yes only works together with --dry-run: a person has to confirm real changes."
	[ -n "$HOST_ARG" ] && [ -n "$SERIAL_ARG" ] && die "Use --host or --serial, not both."
	if [ -n "$HOST_ARG" ] && ! [[ $HOST_ARG =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]]; then die "That doesn't look like an address: $HOST_ARG"; fi
	TMPD=$(mktemp -d "${TMPDIR:-/tmp}/exbloattv.XXXXXX") || die "Couldn't create a temporary folder."
	trap cleanup_on_exit EXIT
	trap on_int INT
	trap 'exit 143' TERM HUP
	if [ "$cmd" = scan ]; then
		cmd_scan
		return
	fi
	find_adb
	load_safety
	me_name
	"$ADB" start-server >/dev/null 2>&1
	case $cmd in
	clean) cmd_clean ;;
	list) cmd_list ;;
	status) cmd_status ;;
	undo) cmd_undo ;;
	esac
}

# Sourcing with EXBLOATTV_LIB=1 loads the functions without running anything (cli/test.sh, cli/gen-catalog.sh).
if [ "${EXBLOATTV_LIB:-}" != 1 ]; then
	main "$@"
fi
