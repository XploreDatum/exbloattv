    <string name="step_atv_1"><![CDATA[Open <b>Settings → Device Preferences → About</b>]]></string>
    <string name="step_atv_2"><![CDATA[Press OK on <b>Build</b> 7 times]]></string>
    <string name="step_atv_3"><![CDATA[Go back to <b>Developer options</b> and turn on <b>USB debugging</b>]]></string>
    <string name="step_gtv_1"><![CDATA[Open <b>Settings → System → About</b>]]></string>
    <string name="step_gtv_2"><![CDATA[Press OK on <b>Android TV OS build</b> 7 times]]></string>
    <string name="step_gtv_3"><![CDATA[Go back to <b>System → Developer options</b> and turn on <b>USB debugging</b>]]></string>
    <string name="step_mi_3"><![CDATA[Go back to <b>Device Preferences → Developer options</b> and turn on <b>USB debugging</b>]]></string>
    <string name="step_newer_1"><![CDATA[Open <b>Settings → System → About</b> (older TVs: <b>Settings → Device Preferences → About</b>)]]></string>
    <string name="step_newer_2"><![CDATA[Press OK on <b>Android TV OS build</b> (older TVs: <b>Build</b>) 7 times]]></string>
    <string name="step_philips_1"><![CDATA[Open <b>Settings → All settings → Android settings → Device Preferences → About</b>]]></string>
    <string name="step_fire_1"><![CDATA[Open <b>Settings → My Fire TV → About</b>]]></string>
    <string name="step_fire_2"><![CDATA[Press OK on your device\'s name (like <b>Fire TV Stick</b>) 7 times]]></string>
    <string name="step_fire_3"><![CDATA[Go back to <b>My Fire TV → Developer options</b> and turn on the <b>debugging</b> switch]]></string>

